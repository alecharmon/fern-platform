{
  "name": "@fern-api/docs-server",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/docs-server"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "source": "src/index.ts",
  "types": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc",
    "depcheck": "knip",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.744.0",
    "@aws-sdk/s3-request-presigner": "^3.744.0",
    "@fern-api/docs-auth": "workspace:*",
    "@fern-api/docs-utils": "workspace:*",
    "@fern-api/fdr-lambda-sdk": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-api/venus-api-sdk": "^0.13.4-7-g5ff8ee8",
    "@fern-docs/edge-config": "workspace:*",
    "@fern-platform/fdr-utils": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@radix-ui/colors": "catalog:",
    "@slack/types": "^2.18.0",
    "@slack/web-api": "^6.9.0",
    "@vercel/functions": "^3.1.0",
    "@workos-inc/node": "^7.31.0",
    "bezier-easing": "^2.1.0",
    "colorjs.io": "^0.5.2",
    "es-toolkit": "catalog:",
    "iron-session": "^8.0.4",
    "jose": "catalog:",
    "next": "catalog:",
    "posthog-node": "^5.26.2",
    "react": "catalog:",
    "ts-essentials": "catalog:",
    "undici": "^6.24.0",
    "unist-util-visit": "^5.0.0",
    "url-join": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-platform/configs": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
