{
  "name": "@fern-platform/supabase",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/supabase-client"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "db:diff": "pnpm exec supabase db diff",
    "db:push": "pnpm exec supabase db push",
    "db:reset": "pnpm exec supabase db reset",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "generate:types": "pnpm exec supabase gen types typescript --project-id mygothwbccfcegfpjtoh > src/database.types.ts",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.2",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "catalog:",
    "depcheck": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
