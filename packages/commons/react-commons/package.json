{
  "name": "@fern-ui/react-commons",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/react-commons"
  },
  "sideEffects": false,
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "source": "src/index.ts",
  "types": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@fern-api/ui-core-utils": "workspace:*",
    "es-toolkit": "catalog:",
    "fastdom": "^1.0.12",
    "immer": "^9.0.15",
    "ts-essentials": "catalog:"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "depcheck": "catalog:",
    "jotai": "catalog:",
    "react": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "^6.1.6",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "jotai": "^2",
    "react": "^19"
  }
}
