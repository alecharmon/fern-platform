{
  "$schema": "https://swc.rs/schema.json",
  "exclude": [".*\\.test\\.tsx?"],
  "jsc": {
    "parser": {
      "decorators": true,
      "syntax": "typescript"
    },
    "transform": {
      "verbatimModuleSyntax": true
    }
  },
  "module": {
    "type": "es6"
  },
  "sourceMaps": true,
  "inlineSourcesContent": false
}
