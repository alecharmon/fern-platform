{
  "name": "@fern-api/docs-utils",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/docs-utils"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types/*": "./src/types/*.ts"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "source": "src/index.ts",
  "types": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals",
    "depcheck": "knip",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@fern-api/fdr-sdk": "workspace:*",
    "date-fns": "^4.1.0",
    "path-to-regexp": "6.3.0",
    "url-join": "catalog:"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "^22.0.0",
    "next": "catalog:",
    "stylelint": "^16.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
