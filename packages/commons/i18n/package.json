{
  "name": "@fern-docs/i18n",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/i18n"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./get-translation": "./src/get-translation.ts",
    "./types": "./src/types.ts"
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "source": "src/index.ts",
  "types": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "dev": "tsc --watch",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "test": "vitest --run --passWithNoTests --globals",
    "depcheck": "knip"
  },
  "dependencies": {},
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
