{
  "name": "@fern-api/docs-loader",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/docs-loader"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/index.client.d.ts",
      "import": "./dist/index.client.js",
      "require": "./dist/index.client.js"
    }
  },
  "main": "src/index.ts",
  "module": "src/index.ts",
  "source": "src/index.ts",
  "types": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@fern-api/docs-auth": "workspace:*",
    "@fern-api/docs-server": "workspace:*",
    "@fern-api/docs-utils": "workspace:*",
    "@fern-api/fai-sdk": "workspace:*",
    "@fern-api/fdr-lambda-sdk": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-api/visual-editor-server": "workspace:*",
    "@fern-docs/edge-config": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@vercel/kv": "^2.0.0",
    "es-toolkit": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "ts-essentials": "catalog:"
  },
  "devDependencies": {
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-platform/configs": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "depcheck": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
