{
  "name": "@fern-platform/emails",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/emails"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/js/index.mjs",
      "require": "./dist/js/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf ./dist",
    "compile": "pnpm compile:js && pnpm compile:types",
    "compile:js": "tsup",
    "compile:types": "tsc --emitDeclarationOnly --project tsconfig.build.json",
    "depcheck": "knip",
    "email:dev": "pnpm patch-preview-server-esbuild && email dev",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "patch-preview-server-esbuild": "tsx scripts/patch-preview-server-esbuild.ts",
    "send-test-email": "tsx scripts/send-test-email.ts",
    "test": "vitest --run --passWithNoTests --globals",
    "test:update": "vitest --run  --passWithNoTests --globals -u"
  },
  "dependencies": {
    "@react-email/components": "1.0.7",
    "@react-email/render": "2.0.4",
    "@react-email/tailwind": "2.0.4",
    "react": "catalog:",
    "resend": "6.9.2"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@react-email/preview-server": "5.2.8",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "esbuild": "0.27.0",
    "react-email": "5.2.8",
    "stylelint": "catalog:",
    "tsup": "catalog:",
    "tsx": "^4.7.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
