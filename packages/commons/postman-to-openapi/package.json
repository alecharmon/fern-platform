{
  "name": "@fern-platform/postman-to-openapi",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/commons/postman-to-openapi"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "source": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
