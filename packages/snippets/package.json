{
  "name": "@fern-api/snippets",
  "version": "0.0.1",
  "description": "Generate usage dynamic snippets for Fern SDKs",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/__test__/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "clean": "rm -rf ./dist && tsc --build --clean",
    "compile": "pnpm build && cp -R ./src/config dist",
    "format": "prettier --write --ignore-unknown --ignore-path .prettierignore \"**\"",
    "format:check": "prettier --check --ignore-unknown --ignore-path .prettierignore \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "test": "vitest --run --passWithNoTests",
    "test:update": "vitest --run --passWithNoTests --update"
  },
  "dependencies": {
    "@fern-api/csharp-dynamic-snippets": "0.0.2",
    "@fern-api/dynamic-ir-sdk": "57.0.0",
    "@fern-api/go-dynamic-snippets": "0.0.15",
    "@fern-api/java-dynamic-snippets": "0.0.3",
    "@fern-api/php-dynamic-snippets": "0.0.5",
    "@fern-api/python-dynamic-snippets": "0.0.2",
    "@fern-api/ruby-dynamic-snippets": "0.0.1",
    "@fern-api/snippets-core": "0.1.11",
    "@fern-api/typescript-dynamic-snippets": "0.0.9",
    "@types/lodash-es": "^4.17.12",
    "lodash-es": "^4.17.21",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@types/jest": "^29.0.3",
    "@types/lodash": "^4.17.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^18.7.18",
    "depcheck": "^1.4.6",
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "lodash-es": "^4.17.21",
    "organize-imports-cli": "^0.10.0",
    "prettier": "^3.5.2",
    "tsup": "^8.3.5",
    "typescript": "5.4.3",
    "vitest": "^2.0.5"
  }
}
