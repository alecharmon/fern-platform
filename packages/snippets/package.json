{
  "name": "@fern-api/snippets",
  "version": "0.0.1",
  "description": "Generate usage dynamic snippets for Fern SDKs",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "!dist/__test__/"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "check-types": "tsc --noEmit",
    "check:browser-compat": "node scripts/check-browser-compat.mjs",
    "clean": "rm -rf ./dist && tsc --build --clean",
    "compile": "pnpm build && cp -R ./src/config dist",
    "depcheck": "knip",
    "format": "prettier --write --ignore-unknown --ignore-path .prettierignore \"**\"",
    "format:check": "prettier --check --ignore-unknown --ignore-path .prettierignore \"**\"",
    "test": "vitest --run --passWithNoTests",
    "test:update": "vitest --run --passWithNoTests --update"
  },
  "dependencies": {
    "@fern-api/csharp-dynamic-snippets": "2.24.5",
    "@fern-api/dynamic-ir-sdk": "65.5.0",
    "@fern-api/go-dynamic-snippets": "1.29.3",
    "@fern-api/java-dynamic-snippets": "3.42.7",
    "@fern-api/php-dynamic-snippets": "2.1.11",
    "@fern-api/python-dynamic-snippets": "4.63.4",
    "@fern-api/ruby-dynamic-snippets": "1.0.9",
    "@fern-api/snippets-core": "0.1.11",
    "@fern-api/swift-dynamic-snippets": "0.27.0",
    "@fern-api/typescript-dynamic-snippets": "3.53.14",
    "@types/lodash-es": "^4.17.12",
    "lodash-es": "^4.17.23",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@types/jest": "^29.0.3",
    "@types/lodash": "^4.17.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^18.7.18",
    "esbuild": "0.27.0",
    "jest": "^29.7.0",
    "lodash-es": "^4.17.23",
    "organize-imports-cli": "^0.10.0",
    "prettier": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
