exports[`Integration Tests > should handle different request types correctly > query-parameters-snippet 1`] = `
"import { CatClient } from "@treetreetree/treetreetree-js";

async function main() {
    const client = new CatClient({
        environment: "https://api.example.com",
        token: "123",
    });
    await client.users.getUsers({
        page: 1,
        limit: 10,
        sort: "name",
    });
}
main();
"
`;
