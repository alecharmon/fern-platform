exports[`Integration Tests > should generate different snippets for different endpoints > create-user-endpoint 1`] = `
"import { CatClient } from "@treetreetree/treetreetree-js";

async function main() {
    const client = new CatClient({
        environment: "https://api.example.com",
        token: "123",
    });
    await client.users.createUser({});
}
main();
"
`;

