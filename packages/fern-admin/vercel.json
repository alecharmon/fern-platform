{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --filter @fern-platform/admin...",
  "buildCommand": "pnpm turbo admin:build",
  "devCommand": "pnpm turbo admin:dev",
  "git": {
    "deploymentEnabled": true
  },
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- ../../packages/fern-admin/",
  "regions": ["iad1", "sfo1", "bom1", "syd1", "sin1"]
}
