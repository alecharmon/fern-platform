{
  "name": "@fern-api/fdr-sdk",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/fdr-sdk"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./navigation": {
      "types": "./dist/types/navigation/index.d.ts",
      "import": "./dist/js/navigation/index.mjs",
      "require": "./dist/js/navigation/index.js",
      "default": "./dist/navigation/index.mjs"
    },
    "./api-definition": {
      "types": "./dist/types/api-definition/index.d.ts",
      "import": "./dist/js/api-definition/index.mjs",
      "require": "./dist/js/api-definition/index.js",
      "default": "./dist/js/api-definition/index.mjs"
    },
    "./docs": {
      "types": "./dist/types/docs/index.d.ts",
      "import": "./dist/js/docs/index.mjs",
      "require": "./dist/js/docs/index.js",
      "default": "./dist/js/docs/index.mjs"
    },
    "./client": {
      "types": "./dist/types/client/FdrClient.d.ts",
      "import": "./dist/js/client/FdrClient.mjs",
      "require": "./dist/js/client/FdrClient.js",
      "default": "./dist/js/client/FdrClient.mjs"
    },
    "./client/types": {
      "types": "./dist/types/client/types.d.ts",
      "import": "./dist/js/client/types.mjs",
      "require": "./dist/js/client/types.js",
      "default": "./dist/js/client/types.mjs"
    },
    "./traversers": {
      "types": "./dist/types/utils/traversers/index.d.ts",
      "import": "./dist/js/utils/traversers/index.mjs",
      "require": "./dist/js/utils/traversers/index.js",
      "default": "./dist/js/utils/traversers/index.mjs"
    },
    "./converters": {
      "types": "./dist/types/converters/index.d.ts",
      "import": "./dist/js/converters/index.mjs",
      "require": "./dist/js/converters/index.js",
      "default": "./dist/js/converters/index.mjs"
    },
    "./navigation/types/latest": {
      "types": "./dist/types/navigation/types/latest.d.ts",
      "import": "./dist/js/navigation/types/latest.mjs",
      "require": "./dist/js/navigation/types/latest.js",
      "default": "./dist/js/navigation/types/latest.mjs"
    },
    "./navigation/types/v1": {
      "types": "./dist/types/navigation/types/v1.d.ts",
      "import": "./dist/js/navigation/types/v1.mjs",
      "require": "./dist/js/navigation/types/v1.js",
      "default": "./dist/js/navigation/types/v1.mjs"
    },
    "./orpc-client": {
      "types": "./dist/types/orpc-client/index.d.ts",
      "import": "./dist/js/orpc-client.mjs",
      "require": "./dist/js/orpc-client.js",
      "default": "./dist/js/orpc-client.mjs"
    },
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/js/index.mjs",
      "require": "./dist/js/index.js",
      "default": "./dist/js/index.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./dist",
    "compile": "pnpm compile:js && pnpm compile:types",
    "compile:js": "tsup",
    "compile:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "dev": "tsup --watch",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "test": "vitest --run --passWithNoTests --globals",
    "test:update": "vitest --run  --passWithNoTests --globals -u",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@fern-api/ui-core-utils": "workspace:*",
    "@orpc/client": "^1.13.5",
    "@orpc/contract": "^1.13.5",
    "@orpc/openapi-client": "^1.13.5",
    "@types/readable-stream": "^4.0.21",
    "@ungap/structured-clone": "^1.2.0",
    "dayjs": "^1.11.11",
    "es-toolkit": "catalog:",
    "escape-string-regexp": "^5.0.0",
    "fast-deep-equal": "^3.1.3",
    "form-data": "4.0.4",
    "httpsnippet-lite": "^3.0.5",
    "js-base64": "3.7.7",
    "node-fetch": "2.7.0",
    "qs": "catalog:",
    "readable-stream": "^4.7.0",
    "tinycolor2": "^1.6.0",
    "ts-essentials": "catalog:",
    "url-join": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@fern-api/snippets": "workspace:*",
    "@fern-platform/configs": "workspace:*",
    "@types/node-fetch": "catalog:",
    "@types/qs": "catalog:",
    "@types/tinycolor2": "^1.4.6",
    "@types/ungap__structured-clone": "^1.2.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
