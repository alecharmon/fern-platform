{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm turbo docs:build",
  "devCommand": "pnpm turbo docs:dev",
  "git": {
    "deploymentEnabled": true
  },
  "env": {
    "USE_REMOTE_RENDERING": "false",
    "REMOTE_RENDERER_URL": "https://remote-mdx-builder.vercel.app"
  },
  "regions": ["iad1", "sfo1", "bom1", "syd1", "sin1"]
}
