# Environment for docs:dev:local - points to local FDR stack
# Started via: pnpm fdr:dev
LOCAL_INFRA_STACK=true

# Local FDR server
NEXT_PUBLIC_FDR_ORIGIN=http://localhost:8080
NEXT_PUBLIC_FDR_LAMBDA_ORIGIN=http://localhost:8081

# Local Venus
VENUS_SERVER_URL=http://localhost:8089

# Local Upstash mock
MWARE_KV_REST_API_URL=http://localhost:8079
MWARE_KV_REST_API_TOKEN=local-dev-token
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=local-dev-token

# Local Edge Config mock
EDGE_CONFIG=http://localhost:8078

# Test domain (change this to the domain you published docs to via local CLI)
NEXT_PUBLIC_DOCS_DOMAIN=plantstore.docs.buildwithfern.com

# Dummy values for required env vars
WORKOS_API_KEY=dummy
WORKOS_CLIENT_ID=dummy
JWT_SECRET_KEY=local-dev-jwt-secret-key-1234567890
OAUTH_JWT_SECRET=local-dev-oauth-secret

# S3 mock (MinIO)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://localhost:9090
AWS_S3_BUCKET_NAME=fdr
DOCS_DEFINITION_S3_BUCKET_NAME=fdr
NEXT_PUBLIC_FILES_ORIGIN=http://localhost:9090
