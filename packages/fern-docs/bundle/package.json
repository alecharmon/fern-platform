{
  "name": "@fern-docs/bundle",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/fern-docs/bundle"
  },
  "sideEffects": false,
  "type": "module",
  "browser": {
    "crypto": false
  },
  "scripts": {
    "build-storybook": "storybook build",
    "check-types": "tsc --noEmit",
    "chromatic": "pnpx chromatic --project-token=chpt_48b3c560025e978",
    "depcheck": "depcheck",
    "docs:build": "NODE_OPTIONS=\"--max-old-space-size=8192\" next build",
    "docs:build:local": "NODE_OPTIONS=\"--max-old-space-size=8192\" NEXT_PUBLIC_IS_LOCAL=1 next build && pnpm tsc --project tsconfig.local.json",
    "docs:build:selfhosted": "NODE_OPTIONS=\"--max-old-space-size=8192\" NODE_ENV=production QSTASH_TOKEN=abc NEXT_PUBLIC_IS_SELF_HOSTED=1 next build && pnpm tsc --project tsconfig.local.json",
    "docs:clean:local": "rm -rf .next next-env.d.ts dist .turbo",
    "docs:dev": "NODE_OPTIONS=\"--max-old-space-size=16384\" NEXT_PUBLIC_IS_DOCS_DEV=true next dev",
    "docs:dev:inspect": "NODE_OPTIONS=\"--max-old-space-size=16384\" NEXT_PUBLIC_IS_DOCS_DEV=true NODE_OPTIONS='--inspect' next dev",
    "docs:hide-env": "mv .env.local .env.local.hidden",
    "docs:lint": "next lint",
    "docs:make:local": "pnpm run docs:build:local && pnpm run docs:rewrite:local",
    "docs:remake:local": "pnpm run docs:clean:local && pnpm run docs:make:local",
    "docs:rewrite:local": "pnpm run docs:rewrite:local:copy && pnpm run docs:rewrite:local:clean && pnpm run docs:rewrite:local:esbuild",
    "docs:rewrite:local:clean": "find .next -depth -mindepth 1 -not -path \".next/standalone*\" -exec rm -rf {} \\;",
    "docs:rewrite:local:copy": "cp -r .next/static .next/standalone/packages/fern-docs/bundle/.next",
    "docs:rewrite:local:esbuild": "rm -rf .next/standalone/node_modules/.pnpm/esbuild@0.27.0 && rm -rf .next/standalone/node_modules/.pnpm/@esbuild+linux-x64@0.27.0",
    "docs:show-env": "mv .env.local.hidden .env.local",
    "docs:start": "next start",
    "docs:start:local": "NODE_ENV=production node .next/standalone/packages/fern-docs/bundle/server.js",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint": "pnpm lint:eslint && pnpm lint:style",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --run --passWithNoTests --globals",
    "test:update": "vitest --run -u --passWithNoTests --globals",
    "typecheck": "tsc --noEmit"
  },
