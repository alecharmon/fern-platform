{
  "name": "@fern-docs/search-ask-fern",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/fern-docs/search-server/ask-fern"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "depcheck": "depcheck",
    "dev": "tsc --watch",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals",
    "test:update": "vitest --run -u --passWithNoTests --globals"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "3.0.0-beta.2",
    "@ai-sdk/anthropic": "2.0.0-beta.2",
    "@ai-sdk/cohere": "2.0.0-beta.2",
    "@fern-api/docs-server": "workspace:*",
    "@fern-api/docs-utils": "workspace:*",
    "ai": "5.0.86",
    "ai-fallback": "^1.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "^22.0.0",
    "depcheck": "^1.4.7",
    "stylelint": "^16.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
