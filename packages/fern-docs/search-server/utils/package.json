{
  "name": "@fern-docs/search-utils",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/fern-docs/search-server/utils"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "depcheck": "depcheck",
    "dev": "tsc --watch",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals",
    "test:update": "vitest --run -u --passWithNoTests --globals"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@fern-api/docs-utils": "workspace:*",
    "@fern-api/fdr-lambda-sdk": "workspace:*",
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-docs/mdx": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "es-toolkit": "^1.32.0",
    "html-entities": "^2.5.2",
    "jose": "catalog:",
    "js-yaml": "^4.1.1",
    "openapi-types": "^12.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "^22.0.0",
    "depcheck": "^1.4.7",
    "stylelint": "^16.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
