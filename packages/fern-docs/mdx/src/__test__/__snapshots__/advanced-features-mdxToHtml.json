{
  "html": "<h1 data-hash=\"946bc3399802b419dac3660ba9f63e6599813db25e5faaeac4ef964e77991477\">Advanced MDX Features Demonstration</h1>\n<p data-hash=\"c8f129cc66f2f63cbbf3c817e014e9c8ce0f63002413aed142c7f6458d0b657f\">This document showcases <strong data-hash=\"fada2dbbcae17ccc50405ad700c5605b7836e966733736a7af03f396b2019679\">unusual</strong> and <em data-hash=\"3fc69f5130441e19137e33af2cdc4f74b20f75555488ef0ee985b13f2312b8ea\">advanced</em> MDX features including ~~strikethrough~~, <code data-hash=\"f61b9198c0d36cc03a4cc5189591e80d288a31d308e08b4873f1bfe565c71101\">inline code</code>, and <custom-element-v2 fve-data-hash=\"b9041614bdb9c8b892f52ab4bd3f478071cb08c57ddd30cb13dbedc7c8b41535\" fve-data-name=\"sup\" fve-mdx-content=\"<sup>superscript</sup>\" fve-unsupported=\"true\"></custom-element-v2> as well as <custom-element-v2 fve-data-hash=\"f6673d6597db12a61bcb53993d636349d4b77759cc0225e80174d80d876566c7\" fve-data-name=\"sub\" fve-mdx-content=\"<sub>subscript</sub>\" fve-unsupported=\"true\"></custom-element-v2> text.</p>\n<h2 data-hash=\"c7ea368871ccf469d770786d0c629a7b821b9794302cfcba5287adc1e9cd8342\">Text Formatting Features</h2>\n<h3 data-hash=\"6676976867c3b60822d737a0b08d3514a471cc3d0e6a68a9dbaa4aedb0a0ef4b\">Emphasis and Strong Text</h3>\n<ul data-hash=\"d9ef05df9de8517ff494632b10f33f65ef4cf0e95d28de0888742c0953b7f19f\">\n<li data-hash=\"e3f7fbdc319212203ce50431ec8675e5b10986c121090294c92ac9d214429a5c\"><strong data-hash=\"b4a23a9bd76e7ac9c8596c38af59c4a0e50f2e9e1f8135a952959d258cc77d1c\">Bold text</strong> with <code data-hash=\"89b0f77ce276d7a1d1ac7d45919c612bfdab21a569c5479ab8b59be2fd946219\">code</code> inside</li>\n<li data-hash=\"f8f07bcf5f4b4b18fcab0cdf676195277bc9e949ae94c9d7e95bf595ed9d4adf\"><em data-hash=\"037abe3e38f49cc8f448db0564d2dd88816eccbfd9572380042fa45b6a3ce854\">Italic text</em> with ~~strikethrough~~ mixed in</li>\n<li data-hash=\"027136a07ce14d4bed0dfb5408c26a606d53abae9d1a8a7c642b6cd4ca46be9d\"><em data-hash=\"617c69958e0384083a55d37e00fd9957db469af5ec4ffb21e0ad292c23f6d345\"><strong data-hash=\"dfdd658c06d452be3944ab0fe9c83a06225add6bd7a010df80a6950d3a3d83cb\">Bold italic</strong></em> combined formatting</li>\n<li data-hash=\"98571d67e486a2cc3a5fb18780e0415e3aeb6270f3d77129f0cec4b2cc14e40a\"><code data-hash=\"ae175a08edbab3a6a11fe2fac8709a92334f462ab119425b9b842fbe086af62c\">Code with **bold** and *italic* inside</code></li>\n</ul>\n<h3 data-hash=\"67129ad5308e4a0e6fe494e643cf3c941ee908051abc70d7825d2a84269bdaba\">Special Characters and Escaping</h3>\n<ul data-hash=\"c015392233e37ebda7ab7cce75045335c122465799457bf9a3424fbd81d3a2ae\">\n<li data-hash=\"3aebcbc30fd1bbd52cf4083b994b8f15cf48f8150a9303e53290fd52878922b6\">HTML entities: &#x26; &#x3C; > \" '</li>\n<li data-hash=\"f0855de33894c7079f303fab30003813e0e83386a8cabd99f73750178f6eb733\">Unicode: 🚀 💻 ⚡ 🎯</li>\n<li data-hash=\"f824102c03337a52d1c23157b7c50753befad09197105fe001c0b4b7412d1e16\">RTL text: مرحبا بالعالم</li>\n<li data-hash=\"7cbbfc471f8a35faa1bcd5bfc01fc4c9640a88352bfed68e7def4a44b84c9800\">Math symbols: α β γ δ ε</li>\n</ul>\n<h2 data-hash=\"68cb4c0a93325f5f487666f9ce0deba6554c9002b7be8f9a96a563646e6971ed\">Advanced Lists</h2>\n<h3 data-hash=\"f6735b04acd21f1db507fc8a2d4fc137d15f5a5c3794a300368fa35fd49efa97\">Task Lists</h3>\n<ul data-hash=\"77e268804f1bc72e873528abd48c384f7a3ad12194bab9df3311a18bc0acd810\">\n<li data-hash=\"85408d80d05778bfc38ad9d238688bc3f8eb408436014acc979257ba49ac2bae\">[x] Completed task with <strong data-hash=\"39fdfa8c72e80eaecb45da0f44db15df4d7f3f57339e764e6ae8f74289a7f36f\">bold</strong> text</li>\n<li data-hash=\"b5a4349ba4117f3878b9372407e7ae1b26bd542dccbbac01a9d00720a1007768\">[ ] Pending task with <code data-hash=\"89b0f77ce276d7a1d1ac7d45919c612bfdab21a569c5479ab8b59be2fd946219\">code</code></li>\n<li data-hash=\"113f8a6ef85c2f02f727d4b5b9e4e8ead61c4fb0547edd75fc1ef56009732d01\">[ ] Another task with ~~strikethrough~~</li>\n</ul>\n<h3 data-hash=\"b0d9feec6cf0ffc4ee75c0caa757b0f2b53b5891300422f7b92c056b66b04a14\">Definition Lists</h3>\n<custom-element-v2 fve-data-hash=\"8d3f52b9333d5b190dabd82b1478c8581cac5e8752f7d7d8a997da6f2dbe9a77\" fve-data-name=\"dl\" fve-mdx-content=\"<dl>\n  <dt>**Bold Term**</dt>\n  <dd>Definition with *italic* and &#x60;code&#x60;</dd>\n  <dt>&#x60;CodeTerm&#x60;</dt>\n  <dd>Definition with ~~strikethrough~~ and <sup>superscript</sup></dd>\n</dl>\" fve-unsupported=\"true\"></custom-element-v2>\n<h3 data-hash=\"97d6699f98d5ae028d2c56c8812ad1a26c1dab757eeca5b418e5170ee40ed25a\">Nested Lists</h3>\n<ol data-hash=\"6908060496e18658a9da843da5bb06c4076bb12aa5abe49c2a791d1da29adc9f\">\n<li data-hash=\"4a7cf44e17bf3acf10cd9680db53fa533e277e70f4f24e3042bbbe425d9b87cb\">First level\n<ul data-hash=\"a9759766b50566b56d9e0a3cad10a3466b9ea01a9fb9752c6543f2ff56f1fc7b\">\n<li data-hash=\"a9759766b50566b56d9e0a3cad10a3466b9ea01a9fb9752c6543f2ff56f1fc7b\">Second level with <strong data-hash=\"39fdfa8c72e80eaecb45da0f44db15df4d7f3f57339e764e6ae8f74289a7f36f\">bold</strong>\n<ul data-hash=\"795ea280d26a31826fa76fa3460e97f86674e2d28e46bfd45ba8738a5e5f592e\">\n<li data-hash=\"795ea280d26a31826fa76fa3460e97f86674e2d28e46bfd45ba8738a5e5f592e\">Third level with <code data-hash=\"89b0f77ce276d7a1d1ac7d45919c612bfdab21a569c5479ab8b59be2fd946219\">code</code>\n<ul data-hash=\"ca835537d3cec5f5d98f1044a73c49419f77874d9eb879b28951ff5131e893df\">\n<li data-hash=\"ca835537d3cec5f5d98f1044a73c49419f77874d9eb879b28951ff5131e893df\">Fourth level with ~~strikethrough~~</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n<li data-hash=\"0e52fce99be45e7dc6653d8297cfeedf12c2f2511fcd36a8cf118cc779f51ad5\">Back to first level\n<ul data-hash=\"c7d6448ab318107d00c3dc4609d59b6ff4ece21b858879fd96b0caefad52cbea\">\n<li data-hash=\"c7d6448ab318107d00c3dc4609d59b6ff4ece21b858879fd96b0caefad52cbea\">Mixed formatting: <strong data-hash=\"39fdfa8c72e80eaecb45da0f44db15df4d7f3f57339e764e6ae8f74289a7f36f\">bold</strong>, <em data-hash=\"33443aba490afeb836e74ab5f604ee50a49ca558b682701444f54dc14b0e32b8\">italic</em>, <code data-hash=\"89b0f77ce276d7a1d1ac7d45919c612bfdab21a569c5479ab8b59be2fd946219\">code</code>, ~~strikethrough~~</li>\n</ul>\n</li>\n</ol>\n<h2 data-hash=\"bcdeaf817028dfbf516a5dd5d270dbedfdf1b90bb7a1bb0a22340a4ea11bb821\">Advanced Tables</h2>\n<p data-hash=\"312f6e9e73742407caef1b4c10bb433eca2e0a1923684c54312c4ad29b8b816e\">| Feature | Description | Example | Status |\n|:--------|:-----------:|--------:|:------:|\n| <strong data-hash=\"968d1ceb1352d102abd7591112845ea9292dabf6584cc6459defb7d189bf7fa0\">Bold</strong> | <em data-hash=\"e2dc5ba8f6d44b5c9095e1694c08a193c8612289ce051b56db85aa58b402dbd3\">Italic</em> | <code data-hash=\"c31f887b6332197757dc6d0933f824527d29ebb48245cc9f93257166ec694251\">Code</code> | ✅ |\n| ~~Strikethrough~~ | <custom-element-v2 fve-data-hash=\"b9041614bdb9c8b892f52ab4bd3f478071cb08c57ddd30cb13dbedc7c8b41535\" fve-data-name=\"sup\" fve-mdx-content=\"<sup>Superscript</sup>\" fve-unsupported=\"true\"></custom-element-v2> | <custom-element-v2 fve-data-hash=\"f6673d6597db12a61bcb53993d636349d4b77759cc0225e80174d80d876566c7\" fve-data-name=\"sub\" fve-mdx-content=\"<sub>Subscript</sub>\" fve-unsupported=\"true\"></custom-element-v2> | ❌ |\n| Mixed: <strong data-hash=\"39fdfa8c72e80eaecb45da0f44db15df4d7f3f57339e764e6ae8f74289a7f36f\">bold</strong> and <em data-hash=\"33443aba490afeb836e74ab5f604ee50a49ca558b682701444f54dc14b0e32b8\">italic</em> | <code data-hash=\"2f5a5a4c0e9363d36a7ffff09ffac626c776b39f01e9933d2f4f028260451a4b\">Code with **bold**</code> | ~~Strike with <code data-hash=\"89b0f77ce276d7a1d1ac7d45919c612bfdab21a569c5479ab8b59be2fd946219\">code</code>~~ | ⚠️ |</p>\n<h3 data-hash=\"29e2299c595af5078fe14b3c261471e4872468ed12e11a3c35534f87eb4a2434\">Complex Table with Nested Content</h3>\n<p data-hash=\"924433add561b908573e5c8e918882b45b2525ed1e733e8170920aeffd915644\">| Component | Props | Children | Notes |\n|-----------|-------|----------|-------|\n| <code data-hash=\"c17363ddab3fc04c0508da515b04e63ba7cbae2493a534138865bcf5973b961f\">&#x3C;div></code> | CSS classes | Text content | Basic HTML |\n| <code data-hash=\"dd44ac292d86dbb9012f16d35be1fe9ae40ac9036bc37f4fdb99b96a63f8dd5d\">&#x3C;span></code> | Inline styles | Any content | Inline elements |\n| <code data-hash=\"0fd09e697e37b738c775987c7e2607d7b49c866df8b2170eb193f2ce5d20e016\">&#x3C;p></code> | Text content | None | Paragraphs |</p>\n<h2 data-hash=\"e4a8bb8acea457110fefc50c02dec765094624a91d823399cc2b4648d312b5cb\">Code Blocks</h2>\n<h3 data-hash=\"d910c146867498d9f33281bd56026d1a064e526c0b23b524322f8b73963899f7\">JavaScript with Syntax Highlighting</h3>\n<pre data-hash=\"3394a6e04e18dde2eee1e21e0d81d73b8421e9dc4688a3f6ea6325cb34406f63\"><code class=\"language-javascript\">// Simple function with template literals\nconst processData = (data, options = {}) => {\n  const { \n    transform = (x) => x, \n    filter = () => true,\n    sort = (a, b) => a - b \n  } = options;\n  \n  return data\n    .filter(filter)\n    .map(transform)\n    .sort(sort);\n};\n\n// Usage with simple props\nconst result = processData(users, {\n  transform: (user) => ({\n    ...user,\n    fullName: `${user.firstName} ${user.lastName}`\n  }),\n  filter: (user) => user.active,\n  sort: (a, b) => a.name.localeCompare(b.name)\n});\n</code></pre>\n<h3 data-hash=\"fdff4df51c29df28a0278633b6f9a33e0e7c94c9b6226b31b58c341b19be018c\">TypeScript with Generics</h3>\n<pre data-hash=\"b851e5712833966552e14771934901260f481498dd1e6508622b4c77ff62b894\"><code class=\"language-typescript\">interface ApiResponse&#x3C;T> {\n  data: T;\n  status: 'success' | 'error';\n  message?: string;\n}\n\nclass ApiClient&#x3C;T> {\n  constructor(private baseUrl: string) {}\n  \n  async fetch&#x3C;R = T>(endpoint: string): Promise&#x3C;ApiResponse&#x3C;R>> {\n    const response = await fetch(`${this.baseUrl}${endpoint}`);\n    return response.json();\n  }\n}\n\n// Usage\nconst userClient = new ApiClient&#x3C;User>('/api/users');\nconst users = await userClient.fetch&#x3C;User[]>('/list');\n</code></pre>\n<h3 data-hash=\"33736f16ae11a70d6f5a07da0cfbc9857fd998b75acdf09ed5f61e56679bbaf4\">CSS with Custom Properties</h3>\n<pre data-hash=\"b503ec7d71026245c3675f6720b3ae423ea86671b0439be727901bcf5f7761e2\"><code class=\"language-css\">:root {\n  --primary-color: #007bff;\n  --secondary-color: #6c757d;\n  --success-color: #28a745;\n  --danger-color: #dc3545;\n}\n\n.simple-component {\n  --component-padding: 1rem;\n  --component-border-radius: 0.5rem;\n  \n  padding: var(--component-padding);\n  border-radius: var(--component-border-radius);\n  background: linear-gradient(\n    135deg,\n    var(--primary-color),\n    var(--secondary-color)\n  );\n  color: white;\n  font-weight: bold;\n  transition: all 0.3s ease;\n}\n\n.simple-component:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);\n}\n</code></pre>\n<h2 data-hash=\"ae39c5da8cb5824f571b7fad7179463a7851c40bfff7519eba3563e142434d93\">Math Expressions</h2>\n<h3 data-hash=\"924bef52758631b9b3d1d1c3e31a878a00c915984e2ce57bea6dc53c8385c0a6\">Inline Math</h3>\n<p data-hash=\"538e94afb7a0870a7b6627e0a0470ded36302ff196dca0c14cd3896f66711a14\">The quadratic formula is: <custom-element-v2 fve-data-hash=\"1732b3bd2108634fd01b19468d6973584f1486ee43f8593a700b45ed4d045ca2\" fve-mdx-content=\"$x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}$\" fve-unsupported=\"true\"></custom-element-v2></p>\n<h3 data-hash=\"f3b0b3bccdcc5c4f765bdfca5292a6d6361e0bd99235d0a726e5573b70ef018a\">Block Math</h3>\n<custom-element-v2 fve-data-hash=\"cb1ec71a9bd9d218cd9ea64be0178d3ead363d85fdedda1275ecf857611e0f15\" fve-mdx-content=\"$$\n\\int_{-\\infty}^{\\infty} e^{-x^2} dx = \\sqrt{\\pi}\n$$\" fve-unsupported=\"true\"></custom-element-v2>\n<h3 data-hash=\"4d6304243c8a29aa65822c37bc4a30a3a9fac9f10919a1d06dc90ddbd37a5573\">Complex Math</h3>\n<custom-element-v2 fve-data-hash=\"c740a3b914fc995e4c619f31f6a5c0a6beeb2f71b67eb19c91c74f319fb4e948\" fve-mdx-content=\"$$\n\\begin{align}\n\\nabla \\cdot \\vec{E} &#x26;= \\frac{\\rho}{\\epsilon_0} \\\\\n\\nabla \\cdot \\vec{B} &#x26;= 0 \\\\\n\\nabla \\times \\vec{E} &#x26;= -\\frac{\\partial \\vec{B}}{\\partial t} \\\\\n\\nabla \\times \\vec{B} &#x26;= \\mu_0\\vec{J} + \\mu_0\\epsilon_0\\frac{\\partial \\vec{E}}{\\partial t}\n\\end{align}\n$$\" fve-unsupported=\"true\"></custom-element-v2>\n<h2 data-hash=\"8731e2935b51af632352d40bf2cb30da13507cb890db8ef66f9671e382010538\">Simple JSX Components</h2>\n<h3 data-hash=\"4aab559d4d034011fdd35c07f3c25dea8017ca192924cb1c46bc0bcc46de43ae\">Basic Component</h3>\n<custom-element-v2 fve-data-hash=\"482d654b4c0210238806f9a1fb613e7822cfb04419fe9397e8b2021385786a53\" fve-data-name=\"div\" fve-mdx-content=\"<div className=&#x22;simple-component&#x22;>\n  <h3>**Simple Component** with *mixed formatting*</h3>\n  <p>This component includes:</p>\n  <ul>\n    <li>**Basic HTML** elements</li>\n    <li>*Mixed formatting* in content</li>\n    <li>&#x60;Code snippets&#x60; and ~~strikethrough~~</li>\n    <li><sup>Superscript</sup> and <sub>subscript</sub></li>\n  </ul>\n</div>\" fve-unsupported=\"true\"></custom-element-v2>\n<h3 data-hash=\"37710ce96fa20b155070adbd87a614823e86982e1eeb7812f78f002498d9cae8\">Fragment with Simple Content</h3>\n<custom-element-v2 fve-data-hash=\"b3550238542deada09b299243b02ab904ab4737a1a6c202ab1adb671c94713c9\" fve-mdx-content=\"<>\n  <div className=&#x22;conditional-content&#x22;>\n    <h4>**Fragment content** with *formatting*</h4>\n    <p>This content uses React fragments.</p>\n  </div>\n</>\" fve-unsupported=\"true\"></custom-element-v2>\n<h2 data-hash=\"8064ff4b07ee8ca6e80c3212f7f89c1fa76d1ff5793ad529a9c2950ea36cfc65\">Blockquotes and Citations</h2>\n<blockquote data-hash=\"3f2bb501ee2198d92e1453c82e8c28a085c626716859b817c7e4b785aaea3a37\">\n<p data-hash=\"b88f380baa38acdcfc6e25e2b41f7d8c6b7adb10fae65399fa338779cd937874\">This is a <strong data-hash=\"3b95d58e2d167f74d750abd537a9431a1f038b476320cee38778698409f91c9b\">blockquote</strong> with <em data-hash=\"443e42c6a049d888faf2b5e52dfecd3d5542a7274d9afd4622ead9b8dd522033\">mixed formatting</em> and <code data-hash=\"89b0f77ce276d7a1d1ac7d45919c612bfdab21a569c5479ab8b59be2fd946219\">code</code>.</p>\n<p data-hash=\"755351d07f53dc4a07a50f7682b0228869b0ce4c1d07f613401f5bfae4c33e88\">It can span multiple lines and include:</p>\n<ul data-hash=\"713ca09c823e7a0a7c812316e6d6a775076562afc2d9f34485f87c8b20d3b869\">\n<li data-hash=\"b8e48cc0700dc868b48d4b8665eea6e078a065e232ed986bca237ee437c44832\">Lists</li>\n<li data-hash=\"6863392269a6fffefdcbdaac353b091e4e1fc47313b00681b7af1eb610ef88e6\"><strong data-hash=\"b4a23a9bd76e7ac9c8596c38af59c4a0e50f2e9e1f8135a952959d258cc77d1c\">Bold text</strong></li>\n<li data-hash=\"34cb0f3991261d9e6552ade4c7dae90e415c3f8c268d2eed8f290eddf62053cb\"><em data-hash=\"037abe3e38f49cc8f448db0564d2dd88816eccbfd9572380042fa45b6a3ce854\">Italic text</em></li>\n<li data-hash=\"a02f82857e98a971615e8b4a4f2ef42e1e0fbbe649411c7868c3a52fcf709985\"><code data-hash=\"e35e6d9ece96ae82a634877698f6ec119f524092963d519463ebf9df48b95ff1\">Code snippets</code></li>\n<li data-hash=\"ed85aaffb56758f9f9fe086bdea4af63991314abf7612c73e5c395365789d130\">~~Strikethrough text~~</li>\n</ul>\n</blockquote>\n<blockquote data-hash=\"af3795b63a6712c0aacd1a6d9d60b68e0c50267c7fbf8f3fef47d732cda02670\">\n<blockquote data-hash=\"b8df14bb00201be35b4acb2e9a9f44e9ff15d84a9677acadd215690d7bf95181\">\n<p data-hash=\"817cb8e49e1faca1f2e788971f094139994f2dae9c149d8182868a50d1bed0ac\">Nested blockquotes are also supported</p>\n<p data-hash=\"61fb5c85eab659a4f84e0fcced635bf05987995fef69ae71b6ad52269e7688ca\">With <strong data-hash=\"2f288f09bb8a908d78a116549b98a695683838bf18978977d508a5f0cbcf27dd\">complex</strong> <em data-hash=\"9aa7138e95f2298f60f80750a1475d08a4e4472f2ae10e35722de5655916a4dd\">formatting</em> and <code data-hash=\"89b0f77ce276d7a1d1ac7d45919c612bfdab21a569c5479ab8b59be2fd946219\">code</code></p>\n</blockquote>\n</blockquote>\n<custom-element-v2 fve-data-hash=\"4d186bb9121d0a999ef5b0fe456891d1b53cf94f75d39bc3546240170b75e486\" fve-data-name=\"blockquote\" fve-mdx-content=\"<blockquote cite=&#x22;https://example.com&#x22;>\n  <p>Blockquote with citation and <strong>HTML</strong> elements.</p>\n  <footer>— <cite>Author Name</cite></footer>\n</blockquote>\" fve-unsupported=\"true\"></custom-element-v2>\n<h2 data-hash=\"ee1eb2049b5bc5f04e8484e4f45e449501734a6effa215873b0cf63596acf35f\">Footnotes</h2>\n<p data-hash=\"a2975e848ac19da00853f8c6ba07909dd7dd4453dda909a237ec16f64edeecf6\">Here's a sentence with a footnote[^1] and another one[^2].</p>\n<p data-hash=\"3fa782ff0b5b155eb98f7b28023aa04c22936e713512b6446fd1c3d6c7cf9008\">[^1]: This is the first footnote with <strong data-hash=\"39fdfa8c72e80eaecb45da0f44db15df4d7f3f57339e764e6ae8f74289a7f36f\">bold</strong> and <em data-hash=\"33443aba490afeb836e74ab5f604ee50a49ca558b682701444f54dc14b0e32b8\">italic</em> text.\n[^2]: This is the second footnote with <code data-hash=\"89b0f77ce276d7a1d1ac7d45919c612bfdab21a569c5479ab8b59be2fd946219\">code</code> and ~~strikethrough~~.</p>\n<h2 data-hash=\"ccd37303241bac95b3a5112bac2bf0c8d1198c2d5477acd33e16ec57ce85dfb6\">Comments</h2>\n<custom-element-v2 fve-data-hash=\"8c51a24a78d5ac86b8d47057caa7f999e88f71399c1ba14cc59bf6b853301af0\" fve-mdx-content=\"{/* This is a JSX comment that should be handled properly */}\" fve-unsupported=\"true\"></custom-element-v2>\n<custom-element-v2 fve-data-hash=\"b20add0398bf15bce4558e54dfbb3190d1e2b0ef462725ffdae053218dfcdea4\" fve-mdx-content=\"{/* \n  Multi-line JSX comment\n  with **bold** and *italic* text\n  and &#x60;code&#x60; snippets\n*/}\" fve-unsupported=\"true\"></custom-element-v2>\n<custom-element-v2 fve-data-hash=\"70c57fbeb2c136bc2adac6fc91a92b5e9a42e57ca1ba81c3b21feb8c142db257\" fve-mdx-content=\"{/* Another comment with special characters: &#x26; < > &#x22; &#x27; */}\" fve-unsupported=\"true\"></custom-element-v2>\n<h2 data-hash=\"af8a6df961bf0787b8e11ad14d5655d9b339927a48ea9877380ebe408d6c3dad\">Advanced Links and References</h2>\n<h3 data-hash=\"0c344c63459a633c06a5170ca0fb3188a095922fb5dab9fb2c8f8d743dde3897\">Complex Links</h3>\n<ul data-hash=\"76fdec74dded8b92798b6400eb895df23457b2ffa4e8e29eed270a2c2f861b64\">\n<li data-hash=\"031a23123789a09895dc55fa0595b9e68ad073a421b9e4cff5e80ad5924f12d1\"><a href=\"https://example.com\" data-hash=\"d9827a4567ef6c210ab5187fc7c1b1a396a5eb0dcf3de2f7be45ca00248f2aba\">Link with <strong data-hash=\"39fdfa8c72e80eaecb45da0f44db15df4d7f3f57339e764e6ae8f74289a7f36f\">bold</strong> text</a></li>\n<li data-hash=\"c277b48865113b2a0d5eaa90075ce6007d56e962af9c835014f704e7d0ec2b0c\"><a href=\"https://example.com/code\" data-hash=\"e66ffb870a95a3beef791c2e20feba2ffe0697440d1dee090d45852a1d8e5a6d\">Link with <code data-hash=\"89b0f77ce276d7a1d1ac7d45919c612bfdab21a569c5479ab8b59be2fd946219\">code</code> text</a></li>\n<li data-hash=\"508ff61bb1896d51368ae9a9636bee2983270a2d72207f727dc48fef2475172d\"><a href=\"https://example.com/strike\" data-hash=\"4f4c9e65b9f09e8ba253dd428b544fac3f900234e2431055daee46030efd715b\">Link with ~~strikethrough~~</a></li>\n</ul>\n<h3 data-hash=\"2eb48172e2fac6bdfb2ad937d23bfd8353c611c1e9b971f4d4f4c5c92fb72be3\">Reference Links</h3>\n<p data-hash=\"714b510615138c2a21e5ed8a8f5c322c5f6dce020c578c58e13986a46ac92b42\"><a href=\"https://example.com\" title=\"Title with **bold** and *italic*\" data-hash=\"1a918e6aedc9c4bc1fdc79142805034dd088f8de0460776e9b60ad8750fcef10\">Complex reference</a> with <strong data-hash=\"8addb0481ab0fa5e5c94828372a9c11d3b3627fd5070a3479aa2f5603d69636b\">formatting</strong>.</p>\n<h2 data-hash=\"d57ec62d938eca6a70d6838173be90aaa263ae055a459079acdfd95e17ed6621\">Inline HTML</h2>\n<custom-element-v2 fve-data-hash=\"9ce36c96f069d828e5951c729143f8a2edd4d598719de971976238064b1624da\" fve-data-name=\"div\" fve-mdx-content=\"<div style={{ \n  background: &#x27;linear-gradient(45deg, #ff6b6b, #4ecdc4)&#x27;,\n  padding: &#x27;20px&#x27;,\n  borderRadius: &#x27;8px&#x27;,\n  color: &#x27;white&#x27;,\n  margin: &#x27;20px 0&#x27;\n}}>\n  <h4>**Inline HTML** with React styles</h4>\n  <p>This div uses inline styles with:</p>\n  <ul>\n    <li>*Gradient backgrounds*</li>\n    <li>&#x60;Custom properties&#x60;</li>\n    <li>~~Complex styling~~</li>\n  </ul>\n</div>\" fve-unsupported=\"true\"></custom-element-v2>\n<h2 data-hash=\"7b0e81b5ef30d0d36a48eacf8b2baf4c6f5101c367f065e29d84348c88d0b4f2\">Simple Event Handlers</h2>\n<custom-element-v2 fve-data-hash=\"4c4a753f49bedae272c73ac812a2981c8dc2c08a6666223de8ab978a947d07b9\" fve-data-name=\"div\" fve-mdx-content=\"<div \n  onClick={() => alert(&#x27;Clicked!&#x27;)}\n  style={{ \n    cursor: &#x27;pointer&#x27;,\n    padding: &#x27;10px&#x27;,\n    border: &#x27;2px solid #007bff&#x27;,\n    borderRadius: &#x27;4px&#x27;,\n    backgroundColor: &#x27;#f8f9fa&#x27;\n  }}\n>\n  <p>**Clickable div** with event handlers</p>\n  <p>This demonstrates basic interactivity.</p>\n</div>\" fve-unsupported=\"true\"></custom-element-v2>\n<h2 data-hash=\"fe87f918edac7593e78ec9d2574076f34c6b8ff0b63fbd35d19699a6405edbc3\">Accessibility Features</h2>\n<custom-element-v2 fve-data-hash=\"7aa11ee86a43ab62047b104e79133d5bec0c622f8e97aff720862fd99ceb53bf\" fve-data-name=\"div\" fve-mdx-content=\"<div role=&#x22;main&#x22; aria-label=&#x22;Main content area&#x22;>\n  <section aria-labelledby=&#x22;section-title&#x22;>\n    <h2 id=&#x22;section-title&#x22;>**Accessible Section**</h2>\n    <p>This section includes proper ARIA attributes and semantic HTML.</p>\n    \n    <button \n      aria-describedby=&#x22;button-description&#x22;\n      onClick={() => console.log(&#x27;Accessible button clicked&#x27;)}\n    >\n      Accessible Button\n    </button>\n    \n    <div id=&#x22;button-description&#x22; aria-hidden=&#x22;true&#x22;>\n      This button performs an accessible action\n    </div>\n  </section>\n</div>\" fve-unsupported=\"true\"></custom-element-v2>\n<h2 data-hash=\"c2b0e4ef98983d7dc2061f32022ef595af2f8b27eabcece4c990e63a51571140\">Simple Expressions</h2>\n<custom-element-v2 fve-data-hash=\"32967810d2cee81e7d9fcee248b494296d647fb53a53020a380ee4f1365b162d\" fve-data-name=\"div\" fve-mdx-content=\"<div>\n  <p>**Dynamic content** examples:</p>\n  <ul>\n    <li>Simple expression: {2 + 2} = 4</li>\n    <li>String template: {&#x60;Hello ${&#x27;World&#x27;}&#x60;}</li>\n    <li>Boolean: {true ? &#x27;Yes&#x27; : &#x27;No&#x27;}</li>\n  </ul>\n</div>\" fve-unsupported=\"true\"></custom-element-v2>\n<h2 data-hash=\"7e7052820c6449d8d37950c0f782f374fb4b4b878ce2deb531cd4050b7cfd465\">Spread Operators</h2>\n<custom-element-v2 fve-data-hash=\"8b178c4638181c5c49ec01e8be633a0fdde6773fc205c08182eea801327e919f\" fve-data-name=\"div\" fve-mdx-content=\"<div \n  {...{\n    className: &#x22;spread-example&#x22;,\n    &#x22;data-testid&#x22;: &#x22;spread-component&#x22;\n  }}\n  style={{\n    &#x27;--custom-property&#x27;: &#x27;value&#x27;,\n    &#x27;--another-property&#x27;: &#x27;another-value&#x27;\n  }}\n>\n  <p>This div uses **spread operators** and *complex props*.</p>\n  <p>It demonstrates advanced React patterns with &#x60;template literals&#x60;.</p>\n</div>\" fve-unsupported=\"true\"></custom-element-v2>\n<hr data-hash=\"cb3f91d54eee30e53e35b2b99905f70f169ed549fd78909d3dac2defc9ed8d3b\">\n<p data-hash=\"6e7073a650f86a09ce968ea7610d23f8b1d3b049e753e7b4f3470f4dc4e5a94c\"><em data-hash=\"4881fb3b4be314502b0003f3c673755abeb4bc6b45604c04901b31cac5473927\">This document demonstrates <strong data-hash=\"512bf459bd7860b6f7fc635124e27b3e04859b59b8432e921faaf1d818276870\">comprehensive</strong> MDX features including ~~advanced~~ formatting, <code data-hash=\"ba4fbec200902c6ea66a4a6428f90b4a271fa627b2d246cdeaa982a5579024ad\">code blocks</code>, and <custom-element-v2 fve-data-hash=\"b9041614bdb9c8b892f52ab4bd3f478071cb08c57ddd30cb13dbedc7c8b41535\" fve-data-name=\"sup\" fve-mdx-content=\"<sup>complex</sup>\" fve-unsupported=\"true\"></custom-element-v2> <custom-element-v2 fve-data-hash=\"f6673d6597db12a61bcb53993d636349d4b77759cc0225e80174d80d876566c7\" fve-data-name=\"sub\" fve-mdx-content=\"<sub>structures</sub>\" fve-unsupported=\"true\"></custom-element-v2>.</em></p>",
