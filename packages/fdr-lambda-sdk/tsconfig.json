{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@fern-platform/configs/tsconfig/library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "es2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "esModuleInterop": true,
    "verbatimModuleSyntax": false
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules"]
}
