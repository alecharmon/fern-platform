# Environment for dashboard:dev:local - points to local FDR/Venus stack
# Auth0 still uses the real dev environment (auth0-mock doesn't support full OAuth flow)
# Started via: pnpm fdr:dev

# Local services
FDR_SERVER_URL=http://localhost:8080
VENUS_SERVER_URL=http://localhost:8089

# Local Edge Config mock
EDGE_CONFIG=http://localhost:8078

# Local Redis/Upstash mock
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=local-dev-token
REDIS_URL=redis://localhost:6379

# Local S3 mock
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=fdr
NEXT_PUBLIC_FILES_ORIGIN=http://localhost:9090
