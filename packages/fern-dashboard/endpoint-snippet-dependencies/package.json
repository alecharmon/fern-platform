{
  "name": "@fern-api/endpoint-snippet-dependencies",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fern-api/fern-platform.git",
    "directory": "packages/fern-dashboard/endpoint-snippet-dependencies"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "source": "src/index.ts",
  "files": ["dist"],
  "scripts": {
    "clean": "rm -rf ./lib ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "depcheck": "depcheck",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:eslint:fix": "pnpm lint:eslint --fix",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "test": "vitest --run --passWithNoTests --globals"
  },
  "dependencies": {
    "@fern-api/docs-utils": "workspace:*",
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-docs/components": "workspace:*",
    "@fern-ui/react-commons": "workspace:*",
    "@radix-ui/primitive": "catalog:",
    "@radix-ui/react-compose-refs": "catalog:",
    "@radix-ui/react-select": "catalog:",
    "es-toolkit": "catalog:",
    "fastdom": "^1.0.12",
    "jotai": "catalog:",
    "lucide-react": "^0.460.0",
    "react": "catalog:",
    "ts-essentials": "catalog:"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "depcheck": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
