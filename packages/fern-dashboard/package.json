  "scripts": {
    "build-storybook": "storybook build",
    "clean": "rm -rf ./.next",
    "dashboard-dev:dev": "cp .env.local-dev .env.local && NODE_OPTIONS=\"--max-old-space-size=16384\" next dev",
    "dashboard-dev:pull": "VERCEL_ORG_ID=team_6FKOM5nw037hv8g2mTk3gaH7 VERCEL_PROJECT_ID=prj_ka9122njnAZrpIWEzatPYzEFL4Ni vercel pull --yes --environment=production --cwd ../.. && cp ../../.vercel/.env.production.local .env.local-dev",
    "dashboard:build": "pnpm generate-templates && next build",
    "dashboard:dev": "NODE_OPTIONS=\"--max-old-space-size=16384\" next dev",
    "dashboard:dev:inspect": "node --inspect --max-old-space-size=16384 node_modules/next/dist/bin/next dev",
    "dashboard:dev:local": "NODE_OPTIONS=\"--max-old-space-size=16384\" pnpm exec dotenv -e .env.local.fdr -e .env.local -- next dev",
    "dashboard:dev:turbopack": "next dev",
    "dashboard:lint": "next lint",
    "dashboard:rsd": "RSD=1 NODE_OPTIONS='--max-old-space-size=8192' next build",
    "dashboard:rsd:client": "rsdoctor analyze --profile .next/.rsdoctor/manifest.json",
    "dashboard:rsd:server": "rsdoctor analyze --profile .next/server/.rsdoctor/manifest.json",
    "dashboard:start": "next start",
    "depcheck": "knip",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "generate-templates": "tsx scripts/generate-templates.ts",
    "lint": "pnpm lint:style",
    "lint:style": "stylelint 'src/**/*.scss' --allow-empty-input --max-warnings 0",
    "lint:style:fix": "pnpm lint:style --fix",
    "storybook": "storybook dev -p 6006",
    "test": "vitest --run --passWithNoTests --globals",
    "typecheck": "tsc --noEmit"
  },
