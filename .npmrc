//npm.fontawesome.com/:always-auth=true

# Hoist @chevrotain packages to fix langium's phantom dependency on @chevrotain/regexp-to-ast
# langium (used by mermaid via @mermaid-js/parser) imports directly from @chevrotain/regexp-to-ast
# but doesn't declare it as a direct dependency, causing flaky builds in pnpm's strict mode
public-hoist-pattern[]=@chevrotain/*
