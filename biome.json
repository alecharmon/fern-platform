{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,ts,tsx,mjs,mts}",
      "**/*.{json,md,mdx}",
      "!**/.husky",
      "!**/.next",
      "!**/.pnp*",
      "!**/.turbo",
      "!**/.venv",
      "!**/.yarn",
      "!**/__snapshots__",
      "!**/__test__/output/**/*",
      "!**/build",
      "!**/dist",
      "!**/fixtures/**/*",
      "!**/generated",
      "!**/lib",
      "!**/node_modules",
      "!**/openapi.json",
      "!**/*.{yaml,yml}",
      "!.eslintrc.js",
      "!packages/fai-sdk/src",
      "!packages/fdr-lambda-sdk/src",
      "!servers/oculus/suites/**/*"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSameLine": false,
    "bracketSpacing": true,
    "expand": "auto"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "complexity": {
        "noBannedTypes": "error",
        "noExtraBooleanCast": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "useOptionalChain": "error"
      },
      "correctness": {
        "noUndeclaredVariables": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "noUnusedImports": "error"
      },
      "security": {
        "noDangerouslySetInnerHtmlWithChildren": "error"
      },
      "style": {
        "noDoneCallback": "error",
        "noNamespace": "off",
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@heroicons/react",
                  "@heroicons/react/16/outline",
                  "@heroicons/react/16/solid",
                  "@heroicons/react/20/outline",
                  "@heroicons/react/20/solid",
                  "@heroicons/react/24/outline",
                  "@heroicons/react/24/solid",
                  "@heroicons/react/outline",
                  "@heroicons/react/solid"
                ],
                "message": "Import the icon from the full path to avoid importing the entire library."
              }
            ]
          }
        },
        "useAsConstAssertion": "error",
        "useBlockStatements": "error",
        "useImportType": "error",
        "useLiteralEnumMembers": "error"
      },
      "suspicious": {
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "off",
        "noConsole": "error",
        "noDoubleEquals": "error",
        "noEmptyBlockStatements": "off",
        "noEmptyInterface": "off",
        "noExplicitAny": "off",
        "noExportsInTest": "error",
        "noExtraNonNullAssertion": "error",
        "noFocusedTests": "error",
        "noIrregularWhitespace": "error",
        "noPrototypeBuiltins": "error",
        "noShadowRestrictedNames": "off",
        "noSkippedTests": "warn",
        "noWith": "error"
      }
    }
  },
  "javascript": {
    "globals": ["expect", "describe", "it", "beforeEach", "test", "beforeAll"],
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "none",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "html": {
    "formatter": {
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/fern-dashboard/**/*",
        "packages/fern-docs/bundle/**/*",
        "packages/fern-docs/icons-cdn/**/*"
      ],
      "linter": {
        "domains": {
          "next": "recommended"
        }
      }
    },
    {
      "includes": [
        "packages/commons/docs-loader/**/*",
        "packages/commons/docs-server/**/*",
        "packages/commons/react-commons/**/*",
        "packages/fern-dashboard/**/*",
        "packages/fern-docs/bundle/**/*",
        "packages/fern-docs/components/**/*",
        "packages/fern-docs/icons-cdn/**/*"
      ],
      "linter": {
        "domains": {
          "react": "recommended"
        }
      }
    },
    {
      "includes": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/__test__/**/*",
        "packages/cdk/scripts/**/*",
        "packages/cdk/**/*",
        "packages/commons/docs-loader/src/readonly-docs-loader.ts",
        "packages/commons/docs-server/**/*",
        "packages/commons/docs-utils/src/getRedirectForPath.ts",
        "packages/commons/github/src/**/*",
        "packages/commons/react-commons/src/useWhyDidYouUpdate.ts",
        "packages/commons/visual-editor-server/src/mongodb-client.ts",
        "packages/commons/visual-editor-server/src/visual-editor-storage.ts",
        "packages/fai-sdk/**/*",
        "packages/fdr-sdk/src/**/*",
        "packages/fern-dashboard/**/*",
        "packages/fern-docs/**/*",
        "packages/workers/proxy/src/websocket.ts",
        "scripts/monitor/**/*.ts",
        "servers/fern-bot/**/*",
        "servers/fdr-deploy/scripts/fdr-deploy-stack.ts",
        "servers/fdr-lambda/src/index.ts",
        "servers/fdr/src/services/revalidator/RevalidatorService.ts",
        "servers/mdx-bundler/src/plugins/rehype-code-block.ts",
        "servers/mdx-bundler/src/serialize.ts",
        "servers/mdx-bundler/src/server.ts",
        "servers/self-hosted/scripts/generate-encryption-key.js",
        "servers/self-hosted/scripts/perf-test.ts",
        "smoke-test/**/*",
        "tests/**/*"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.json", "**/*.md", "**/*.css", "**/*.mdx"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "packages/workers/proxy/src/websocket.ts",
        "packages/fern-docs/components/src/__test__/CopyToClipboardButton.test.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/commons/docs-server/src/generateRadixColors.ts", "servers/fern-bot/src/libs/env.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/commons/docs-server/src/generateFernColors.test.ts",
        "packages/commons/github/src/__test__/getLatestTag.test.ts",
        "packages/fern-docs/bundle/src/mdx/bundler/serialize.test.ts",
        "packages/fern-docs/bundle/src/mdx/plugins/rehype-steps.test.ts",
        "packages/fern-docs/components/src/__test__/CopyToClipboardButton.test.tsx",
        "servers/fern-bot/src/__test__/grpc-proxy.test.ts",
        "servers/fdr/src/__test__/local/revalidate.test.ts",
        "servers/fdr/src/__test__/local/s3.test.ts",
        "servers/fdr/src/services/s3/__test__/s3.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noSkippedTests": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/commons/docs-server/src/FernNextResponse.ts",
        "packages/commons/docs-utils/src/changelog.ts",
        "packages/commons/fdr-utils/src/definition-object-factory.ts",
        "packages/fdr-sdk/src/api-definition/typeid-visitor.ts",
        "packages/fdr-sdk/src/navigation/ApiTypeIdVisitor.ts",
        "packages/fern-docs/bundle/src/server/FernNextResponse.ts",
        "servers/fdr/src/db/snippets/SdkIdFactory.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noStaticOnlyClass": "off"
          }
        }
      }
    },
    {
      "includes": [
        "servers/fdr/src/controllers/api/getApiReadService.ts",
        "servers/fdr/src/controllers/api/getApiLatestService.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noUselessCatch": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/fern-dashboard/src/utils/tiptap-utils.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/fern-docs/bundle/src/mdx/plugins/rehype-links.test.ts",
        "servers/fdr/src/__test__/local/services/api.test.ts",
        "servers/fdr/src/__test__/local/services/diff.test.ts",
        "servers/fdr/src/__test__/local/services/docs.test.ts",
        "servers/fdr/src/__test__/local/services/docsCache.test.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExportsInTest": "off"
          }
        }
      }
    },
    {
      "includes": ["servers/fdr/src/__test__/unit-tests/transform/testTransformApiDefinitionToDb.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["servers/fdr/src/services/docs-cache/RedisDocsDefinitionStore.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noRedeclare": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/commons/docs-utils/src/http-methods.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noPrototypeBuiltins": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
