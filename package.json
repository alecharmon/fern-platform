    "vitest": "^3.0.7"
  },
  "dependenciesMeta": {
    "jsonc-parser@2.2.1": {
      "unplugged": true
    }
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "10.11.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@sentry/cli",
      "@sentry/profiling-node",
