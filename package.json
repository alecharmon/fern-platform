{
  "name": "fern-platform-monorepo",
  "private": true,
  "description": "Fern Platform Monorepo",
  "repository": "https://github.com/fern-api/fern-platform",
  "author": "Birch Solutions, Inc.",
  "scripts": {
    "add-translation": "pnpm tsx scripts/add-translation.ts",
    "aws:up": "pnpm up -r \"@aws-sdk/*\"",
    "build": "turbo build",
    "check": "pnpm check:knip && pnpm check:biome",
    "check-docs-release-blockers": "pnpm tsx packages/scripts/src/cli.ts -- fern-scripts check-docs-release-blockers",
    "check:biome": "pnpm exec biome check",
    "check:biome:fix": "pnpm exec biome check --write",
    "check:fix": "pnpm check:biome:fix && pnpm check:knip:fix",
    "check:knip": "knip --no-config-hints",
    "check:knip:fix": "knip --no-config-hints --fix",
    "clean": "turbo clean",
    "codegen": "turbo codegen",
    "compile": "turbo compile",
    "dashboard-dev:dev": "turbo dashboard:dev",
    "dashboard-dev:pull": "VERCEL_ORG_ID=team_6FKOM5nw037hv8g2mTk3gaH7 VERCEL_PROJECT_ID=prj_ka9122njnAZrpIWEzatPYzEFL4Ni vercel pull --yes --environment=production && cp .vercel/.env.production.local packages/fern-dashboard/.env.local",
    "dashboard:dev": "turbo dashboard:dev",
    "dashboard:dev:inspect": "turbo dashboard:dev:inspect",
    "dashboard:dev:turbopack": "turbo dashboard:dev:turbopack",
    "dashboard:pull": "VERCEL_ORG_ID=team_6FKOM5nw037hv8g2mTk3gaH7 VERCEL_PROJECT_ID=prj_7PayvneDidzQ3RW6SUFMTN88chaa vercel pull --environment=development && cp .vercel/.env.development.local packages/fern-dashboard/.env.local",
    "depcheck": "turbo depcheck",
    "docs:build": "turbo docs:build",
    "docs:dev": "turbo docs:dev",
    "docs:dev:trace": "bash scripts/docs-dev-trace.sh",
    "docs:local-bundle:build": "NODE_ENV=production bash scripts/build-local-bundle.sh",
    "docs:local-bundle:deploy": "pnpm docs:local-bundle:resetDir && pnpm docs:local-bundle:unzip && pnpm docs:local-bundle:setup && echo 'Use local bundle by running: fern docs dev --bundle-path ~/.fern/app-preview-local/.next'",
    "docs:local-bundle:resetDir": "rm -rf ~/.fern/app-preview-local && mkdir -p ~/.fern/app-preview-local && mkdir -p ~/.fern/app-preview-local/.next",
    "docs:local-bundle:setup": "ts-node --compiler-options='{\"module\":\"commonjs\",\"types\":[\"node\"]}' ./packages/cdk/scripts/setupLocalBundle.ts",
    "docs:local-bundle:unzip": "tar -xzf ./docs_bundle.tar.gz -C ~/.fern/app-preview-local/.next",
    "docs:self-hosted-bundle:build": "NODE_ENV=production bash scripts/build-selfhosted-bundle.sh \"${BASE_PATH:-}\"",
    "docs:self-hosted-docker:build": "pnpm --filter=@fern-platform/fdr build:tsup:cjs && cd servers/self-hosted && bash create_self_hosted_docker.sh fern-self-hosted latest",
    "docs:self-hosted-docker:build-container": "pnpm --filter=@fern-platform/fdr build:tsup:cjs && cd servers/self-hosted && SKIP_BUNDLE=1 bash create_self_hosted_docker.sh fern-self-hosted latest",
    "docs:self-hosted-docker:export": "cd servers/self-hosted && bash scripts/export-static-site.sh",
    "docs:self-hosted-fdr:compile": "bash scripts/compile-selfhosted-fdr.sh",
    "docs:start": "turbo docs:start",
    "fai:dev": "bash scripts/run-local-fai.sh",
    "fai:generate": "pnpm fern generate --api fai && pnpm turbo --filter=@fern-api/fai-sdk compile",
    "fdr-lambda:dev": "bash scripts/start-local-fdr-lambda.sh",
    "fdr:dev": "cd servers/fdr && docker compose -f docker-compose.dev.yml up -d --build && pnpm db:migrate:local && dotenv -e .env.local.dev -- tsx --watch src/server.ts",
    "fdr:dev:stop": "cd servers/fdr && docker compose -f docker-compose.dev.yml down",
    "fdr:local": "bash scripts/start-local-fdr.sh",
    "fdr:seed": "bash scripts/seed-local-fdr.sh",
    "fdr:link-to-cli": "bash scripts/link-fdr-sdk-to-cli.sh",
    "fdr:reset": "pnpm --filter=@fern-platform/fdr db:reset:local",
    "fdr:local:stop": "bash scripts/stop-local-fdr.sh",
    "fdr:unlink-from-cli": "bash scripts/unlink-fdr-sdk-from-cli.sh",
    "format": "pnpm format:package-json && pnpm check:fix && pnpm format:yaml:fix",
    "format:check": "pnpm check && pnpm format:yaml:check",
    "format:package-json": "sort-package-json \"generators/**/package.json\" \"packages/**/package.json\" --ignore \"**/dist\" --ignore \"**lib\" --ignore \"**/node_modules\"",
    "format:yaml:check": "prettier --check \"**/*.{yml,yaml}\"",
    "format:yaml:fix": "prettier --write \"**/*.{yml,yaml}\"",
    "preinstall": "npx only-allow pnpm",
    "knip": "knip --no-config-hints",
    "lint": "pnpm lint:biome && pnpm lint:style && pnpm format:check",
    "lint:biome": "biome lint --error-on-warnings",
    "lint:biome:fix": "biome format --write",
    "lint:i18n": "biome lint --only=nursery/noJsxLiterals \"packages/fern-docs/**/*.tsx\"",
    "lint:fix": "pnpm root-package:fix && pnpm lint:biome:fix && pnpm lint:style:fix && pnpm format",
    "lint:style": "turbo lint:style",
    "lint:style:fix": "turbo lint:style:fix",
    "playwright:build": "turbo --filter='playwright-*' --filter='@fern-docs/local-preview-bundle' build",
    "playwright:e2etest": "pnpm exec playwright test",
    "publish": "pnpm -r --filter=!private --parallel exec -- npm publish --access public",
    "radix:up": "pnpm up -r \"@radix-ui/*\"",
    "root-package:check": "pnpm tsx packages/scripts/src/cli.ts -- fern-scripts check-root-package",
    "root-package:fix": "pnpm root-package:check --fix",
    "smoke-test": "pnpm tsx scripts/smoke-test.ts",
    "test": "CI=true turbo test",
    "test:e2e": "pnpm --filter=@fern-platform/playwright e2e",
    "test:e2e:headed": "pnpm --filter=@fern-platform/playwright e2e:headed",
    "test:update": "CI=true turbo test -- -u",
    "vercel-scripts": "pnpm --filter=@fern-platform/vercel-scripts vercel-scripts",
    "vercel:up": "pnpm up -r \"@vercel/*\"",
    "visual-diff": "pnpm tsx scripts/visual-diff.ts",
    "visual-diff:serve": "pnpm tsx scripts/visual-diff-serve.ts"
  },
