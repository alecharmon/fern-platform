{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build", "^compile", "codegen"],
      "inputs": [
        "$TURBO_ARGS",
        "src/**",
        "package.json",
        "tsconfig*.json",
        "build*.mjs",
        "$TURBO_ROOT$/packages/configs/**"
      ]
    },
    "codegen": {
      "cache": false
    },
    "compile": {
      "outputs": ["dist/**", "lib/**", "*.tsbuildinfo"],
      "dependsOn": ["^compile"],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig*.json", "$TURBO_ROOT$/packages/configs/**"],
      "env": ["NODE_ENV", "VERCEL_ENV"]
    },
    "check-types": {
      "dependsOn": ["^compile"]
    },
    "lint": {
      "outputs": []
    },
    "lint:eslint": {
      "outputs": [],
      "inputs": ["src/**", "tests/**", "$TURBO_ROOT$/eslint.config.mjs", "$TURBO_ROOT$/biome.json", "tsconfig.json"]
    },
    "lint:style": {
      "outputs": [],
      "inputs": ["src/**", "$TURBO_ROOT$/.stylelintrc.json", ".stylelintrc.json"]
    },
    "lint:eslint:fix": {
      "outputs": [],
      "inputs": ["src/**", "tests/**", "$TURBO_ROOT$/eslint.config.mjs", "$TURBO_ROOT$/biome.json", "tsconfig.json"]
    },
    "lint:style:fix": {
      "outputs": [],
      "inputs": ["src/**", "$TURBO_ROOT$/.stylelintrc.json", ".stylelintrc.json"]
    },
    "format:check": {
      "outputs": [],
      "inputs": ["src/**", "tests/**", "$TURBO_ROOT$/biome.json"]
    },
    "depcheck": {
      "outputs": [],
      "inputs": ["src/**", "tests/**", "package.json", ".depcheckrc.json"]
    },
    "clean": {
      "cache": false
    },
    "format": {
      "outputs": [],
      "inputs": ["src/**", "tests/**", "$TURBO_ROOT$/biome.json"]
    },
    "test": {
      "dependsOn": ["compile"],
      "outputs": [],
      "inputs": [
        "$TURBO_ROOT$/packages/configs/**",
        "src/**",
        "tests/**",
        "tsconfig.json",
        "vitest.config.{js,mjs,mts,ts,cjs,cts}"
      ],
      "env": ["UPDATE_SNAPSHOTS"]
    },
    "test:update": {
      "dependsOn": ["compile"],
      "outputs": [],
      "inputs": [
        "$TURBO_ROOT$/packages/configs/**",
        "src/**",
        "tests/**",
        "tsconfig.json",
        "vitest.config.{js,mjs,mts,ts,cjs,cts}"
      ],
      "env": ["UPDATE_SNAPSHOTS"],
      "cache": false
    },
    "test-db": {
      "dependsOn": ["compile"],
      "outputs": [],
      "inputs": [
        "$TURBO_ROOT$/packages/configs/**",
        "src/**",
        "tests/**",
        "tsconfig.json",
        "vitest.config.{js,mjs,mts,ts,cjs,cts}"
      ]
    },
    "test-ete": {
      "dependsOn": ["compile"],
      "outputs": [],
      "inputs": [
        "$TURBO_ROOT$/packages/configs/**",
        "src/**",
        "tests/**",
        "tsconfig.json",
        "vitest.config.{js,mjs,mts,ts,cjs,cts}"
      ]
    },
    "test:e2e": {
      "cache": false,
      "env": ["DASHBOARD_URL", "DOCS_URL", "FERN_CI_AUTOMATED_TESTING"]
    },
    "test:self-hosted": {},
    "dev": {
      "persistent": true
    },
    "docs:dev": {
      "persistent": true,
      "dependsOn": ["^build", "^compile"],
      "inputs": ["$TURBO_DEFAULT$", ".env.production.local", ".env.local", ".env.production", ".env"]
    },
    "dashboard:dev": {
      "persistent": true,
      "dependsOn": ["^compile"],
      "inputs": ["$TURBO_DEFAULT$", ".env.local", ".env"]
    },
    "dashboard:dev:inspect": {
      "persistent": true,
      "dependsOn": ["^compile"],
      "inputs": ["$TURBO_DEFAULT$", ".env.local", ".env"]
    },
    "dashboard:dev:turbopack": {
      "persistent": true,
      "dependsOn": ["^compile"],
      "inputs": ["$TURBO_DEFAULT$", ".env.local", ".env"]
    },
    "docs:build": {
      "dependsOn": ["^build", "^compile", "^docs:build"],
      "inputs": ["$TURBO_ARGS", "$TURBO_DEFAULT$"],
      "env": [
        "ALGOLIA_API_KEY",
        "ALGOLIA_APP_ID",
        "ALGOLIA_SEARCH_API_KEY",
        "ALGOLIA_WRITE_API_KEY",
        "ANTHROPIC_API_KEY",
        "AWS_ACCESS_KEY_ID",
        "AWS_REGION",
        "AWS_S3_BUCKET_NAME",
        "AWS_S3_ENDPOINT",
        "AWS_SECRET_ACCESS_KEY",
        "COHERE_API_KEY",
        "DEPLOYMENT_PROMOTED_WEBHOOK_SECRET",
        "DOCS_DEFINITION_S3_BUCKET_NAME",
        "DYNAMIC_IR_S3_BUCKET_NAME",
        "EDGE_CONFIG",
        "ENABLE_ROOT_PATH_BUILD_CACHE",
        "ENABLE_SOURCE_MAPS",
        "FAI_SERVER_URL",
        "FERN_TOKEN",
        "HIGHLIGHT_PROJECT_ID_FERN_APP",
        "JWT_SECRET_KEY",
        "KV_REST_API_READ_ONLY_TOKEN",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "KV_URL",
        "NEXT_PUBLIC_FONTAWESOME_CDN_HOST",
        "NEXT_PUBLIC_IS_LOCAL",
        "NEXT_PUBLIC_TRAILING_SLASH",
        "OAUTH_JWT_SECRET",
        "OPENAI_API_KEY",
        "POSTHOG_ANALYTICS_PROJECT_ID",
        "QSTASH_CURRENT_SIGNING_KEY",
        "QSTASH_NEXT_SIGNING_KEY",
        "QSTASH_TOKEN",
        "QSTASH_URL",
        "SLACK_TOKEN",
        "TURBOPUFFER_API_KEY",
        "WORKOS_API_KEY",
        "WORKOS_CLIENT_ID",
        "NEXT_PUBLIC_IS_SELF_HOSTED"
      ],
      "passThroughEnv": [
        "ANALYZE",
        "NODE_ENV",
        "ESBUILD_BINARY_PATH",
        "VERCEL",
        "VERCEL_AUTOMATION_BYPASS_SECRET",
        "VERCEL_DEPLOYMENT_ID",
        "VERCEL_ENV",
        "VERCEL_URL",
        "NEXT_DEPLOYMENT_ID"
      ]
    }
  },
  "globalDependencies": [
    ".npmrc",
    ".prettierrc.json",
    ".stylelintrc.json",
    "biome.json",
    "eslint.config.mjs",
    "package.json",
    "tsconfig.json",
    "turbo.json"
  ]
}
