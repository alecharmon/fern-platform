{
  "name": "@fern-platform/fdr-lambda",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist lambda.zip",
    "deploy": "pnpm package && aws lambda update-function-code --function-name fdr-lambda --zip-file fileb://lambda.js",
    "dev": "tsup --watch",
    "package": "pnpm build && cp dist/index.js lambda.js",
    "test": "vitest --run --globals",
    "test:watch": "vitest --globals"
  },
  "dependencies": {
    "@types/aws-lambda": "^8.10.143"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.11.3",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^1.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
