{
  "extends": "../../shared/tsconfig.shared.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./bin",
    "rootDir": ".",
    "lib": ["ES2020"],
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
