{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "compile": {
      "outputs": ["lib/**"],
      "dependsOn": ["^compile", "codegen"]
    },
    "test": {
      "dependsOn": ["compile", "codegen"]
    },
    "test:local": {
      "dependsOn": ["compile", "codegen"]
    },
    "test:ete": {
      "dependsOn": ["compile", "codegen"]
    }
  }
}
