# Environment variables for `pnpm fdr:dev` (full local dev with Venus stack)
# Loaded automatically by the fdr:dev script via dotenv-cli
#
# Uses production-style config (LOCAL_MODE_OVERRIDE=false) so behavior
# matches prod as closely as possible (e.g. S3 keys include domain prefix).

DATABASE_URL="postgresql://fdr:fdr1!@localhost:5432/fdr?schema=public"
VENUS_URL="http://localhost:8089"
AUTH0_DOMAIN="localhost:3100"

# AWS credentials (MinIO)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# S3 buckets — all point to the same MinIO bucket
PUBLIC_S3_BUCKET_NAME=fdr
PUBLIC_S3_BUCKET_REGION=us-east-1
PUBLIC_S3_URL_OVERRIDE=http://localhost:9090
PUBLIC_S3_FORCE_PATH_STYLE=true

PRIVATE_S3_BUCKET_NAME=fdr
PRIVATE_S3_BUCKET_REGION=us-east-1
PRIVATE_S3_URL_OVERRIDE=http://localhost:9090

DB_DOCS_DEFINITION_BUCKET_NAME=fdr
DB_DOCS_DEFINITION_BUCKET_REGION=us-east-1
DB_DOCS_DEFINITION_BUCKET_URL_OVERRIDE=http://localhost:9090

API_DEFINITION_SOURCE_BUCKET_NAME=fdr
API_DEFINITION_SOURCE_BUCKET_REGION=us-east-1
API_DEFINITION_SOURCE_BUCKET_URL_OVERRIDE=http://localhost:9090

LIBRARY_DOCS_S3_BUCKET_NAME=fdr
LIBRARY_DOCS_S3_BUCKET_REGION=us-east-1
LIBRARY_DOCS_S3_URL_OVERRIDE=http://localhost:9090

PDF_EXPORT_S3_BUCKET_NAME=fdr
PDF_EXPORT_S3_BUCKET_REGION=us-east-1
PDF_EXPORT_S3_URL_OVERRIDE=http://localhost:9090

# PDF export (LocalStack SQS)
PDF_EXPORT_SQS_REGION=us-east-1
PDF_EXPORT_SQS_QUEUE_URL=http://localhost:4566/000000000000/pdf-export-queue.fifo
PDF_EXPORT_CALLBACK_BASE_URL=http://localhost:8080
PDF_EXPORT_JWT_SECRET_KEY=local-dev-pdf-export-jwt-secret

# Other required config
DOMAIN_SUFFIX=docs.buildwithfern.com
SLACK_TOKEN=local
DOCS_CACHE_ENDPOINT=local
ENABLE_CUSTOMER_NOTIFICATIONS=false
REDIS_ENABLED=false
APPLICATION_ENVIRONMENT=local
PUBLIC_DOCS_CDN_URL=http://localhost:9090/fdr

RESEND_API_KEY=dummy
LOG_LEVEL=info

# Upstash REST API mock (local-mocks container)
MWARE_KV_REST_API_URL=http://localhost:8079
MWARE_KV_REST_API_TOKEN=local-dev-token
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=local-dev-token

# Edge Config mock (local-mocks container)
EDGE_CONFIG=http://localhost:8078

# Library docs parsers (Lambda RIE containers in docker-compose.dev.yml)
PYTHON_LIBRARY_DOCS_LAMBDA_FUNCTION_NAME=function
PYTHON_LIBRARY_DOCS_LAMBDA_REGION=us-east-1
PYTHON_LIBRARY_DOCS_LAMBDA_ENDPOINT=http://localhost:9001

CPP_LIBRARY_DOCS_LAMBDA_FUNCTION_NAME=function
CPP_LIBRARY_DOCS_LAMBDA_REGION=us-east-1
CPP_LIBRARY_DOCS_LAMBDA_ENDPOINT=http://localhost:9002
