{
  "name": "@fern-platform/fdr",
  "version": "0.0.0",
  "repository": "git@github.com:fern-api/fern-definition-registry.git",
  "license": "MIT",
  "author": "Deep Singhvi <deep@buildwithfern.com>",
  "type": "module",
  "main": "dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build:tsup:cjs": "tsup src/server.ts --config tsup.config.ts --format cjs --out-dir cjs",
    "build:tsup:esm": "tsup src/server.ts --format esm --out-dir dist/esm",
    "clean": "rm -rf ./dist && tsc --build --clean",
    "codegen": "prisma generate",
    "compile": "pnpm codegen && tsc --build",
    "db:migrate:dev": "dotenv -e .env.dev -- prisma migrate deploy",
    "db:migrate:local": "dotenv -e .env.migrate -- prisma migrate dev",
    "db:migrate:prod": "dotenv -e .env.prod -- prisma migrate deploy",
    "db:reset:local": "dotenv -e .env.migrate -- prisma migrate reset --force",
    "dev": "tsx src/server.ts --watch",
    "devjs": "node --experimental-specifier-resolution=node dist/server.js",
    "docker:build:test": "docker build -f Dockerfile --target installer ../..",
    "docker:dev": "dotenv -e .env.dev -- ./create_docker.sh",
    "docker:local": "dotenv -e .env.test -- ./create_docker.sh local",
    "docker:prod": "dotenv -e .env.prod -- ./create_docker.sh",
    "format": "prettier --write --ignore-unknown \"**\"",
    "format:check": "prettier --check --ignore-unknown \"**\"",
    "format:prisma": "prisma format",
    "generate:library-docs-ir-openapi": "tsx scripts/generate-library-docs-ir-openapi.ts",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "test": "vitest --run src/** --globals",
    "test:ete": "dotenv -e .env.ete -- vitest src/__test__/ete --globals --config src/__test__/ete/vitest.config.ts",
    "test:local": "dotenv -e .env.test -- vitest src/__test__/local/services/docs.test.ts --globals --config src/__test__/local/vitest.config.ts --no-file-parallelism",
    "test:update": "vitest --run src/** --globals -u"
  },
  "dependencies": {
    "@orpc/experimental-pino": "^1.13.6",
    "@orpc/openapi": "^1.13.6",
    "@orpc/server": "^1.13.6",
    "@prisma/client": "5.13.0",
    "date-fns": "^4.1.0",
    "jose": "catalog:",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.744.0",
    "@aws-sdk/client-s3": "^3.744.0",
    "@aws-sdk/client-sqs": "^3.744.0",
    "@aws-sdk/s3-request-presigner": "^3.744.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fern-api/docs-pdf": "workspace:*",
    "@fern-api/fdr-sdk": "workspace:*",
    "@fern-api/github": "workspace:*",
    "@fern-api/ui-core-utils": "workspace:*",
    "@fern-api/user-permissions": "workspace:*",
    "@fern-api/venus-api-sdk": "^0.19.5",
    "@fern-platform/configs": "workspace:*",
    "@fern-platform/emails": "workspace:*",
    "@fern-platform/entitlements": "workspace:*",
    "@orpc/zod": "^1.13.6",
    "@slack/web-api": "^6.9.0",
    "@types/html-to-text": "^9.0.1",
    "@types/marked": "^5.0.0",
    "@types/semver": "^7.5.8",
    "@types/url-join": "^4.0.1",
    "@types/uuid": "^9.0.1",
    "@upstash/redis": "^1.35.6",
    "dotenv-cli": "^6.0.0",
    "es-toolkit": "^1.32.0",
    "execa": "^9.5.1",
    "fastify": "^5.8.1",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.4.1",
    "latest-version": "^9.0.0",
    "marked": "^5.1.0",
    "neverthrow": "^8.2.0",
    "p-limit": "^7.3.0",
    "prisma": "5.13.0",
    "semver": "^7.6.2",
    "tsup": "catalog:",
    "tsx": "^4.7.1",
    "typescript": "catalog:",
    "undici": "^6.24.0",
    "url-join": "^4.0.1",
    "uuid": "catalog:",
    "vitest": "catalog:",
    "winston": "^3.10.0",
    "zod": "catalog:"
  }
}
