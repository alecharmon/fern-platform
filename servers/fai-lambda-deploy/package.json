{
  "name": "@fern-platform/fai-lambda-deploy",
  "version": "0.1.0",
  "bin": "bin/fai-lambda-deploy.js",
  "scripts": {
    "cdk": "cdk",
    "deploy:dev:code-indexing": "cdk deploy fai-code-indexing-dev2 --require-approval never --progress events",
    "deploy:dev:chat": "cdk deploy fai-chat-dev2 --require-approval never --progress events",
    "deploy:preview:chat": "cdk deploy fai-chat-preview-$PR_NUMBER --require-approval never --progress events --outputs-file preview-output.json",
    "deploy:prod:code-indexing": "cdk deploy fai-code-indexing-prod --require-approval never --progress events",
    "deploy:prod:chat": "cdk deploy fai-chat-prod --require-approval never --progress events",
    "destroy:preview:chat": "cdk destroy fai-chat-preview-$PR_NUMBER --force",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@fern-fern/fern-cloud-sdk": "^0.0.305",
    "aws-cdk-lib": "^2.215.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1029.1",
    "ts-node": "^10.9.1",
    "typescript": "catalog:"
  }
}
