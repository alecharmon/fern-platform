            </listitem>
            <listitem>
              <para>Compatible with <ref refid="structDeviceRadixSort" kindref="compound">DeviceRadixSort</ref> when sorting arithmetic types.</para>
            </listitem>
          </itemizedlist>
        </para>
      </simplesect>
    </para>
