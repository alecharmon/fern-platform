FROM cgr.dev/chainguard/wolfi-base:latest

# Create timestamp logging utilities for build process
RUN mkdir -p /usr/local/bin && \
    printf '#!/bin/sh\necho "[$(date +%%Y-%%m-%%d\ %%H:%%M:%%S)] $*"\n' > /usr/local/bin/log && \
    chmod +x /usr/local/bin/log && \
    printf '#!/bin/sh\nwhile IFS= read -r line; do echo "[$(date +%%Y-%%m-%%d\ %%H:%%M:%%S)] $line"; done\n' > /usr/local/bin/add-timestamps && \
    chmod +x /usr/local/bin/add-timestamps

# Install Node.js and npm
RUN log "Installing Node.js and npm..." && \
    apk add --no-cache nodejs npm 2>&1 | add-timestamps

RUN log "Installing turbo..." && \
    npm install -g turbo@2.0.1 2>&1 | add-timestamps

COPY . .
RUN log "Installing pnpm..." && \
    npm install -g pnpm@9.15.9 2>&1 | add-timestamps
RUN log "Cleaning up fern directory..." && \
    rm -rf fern/

RUN log "Running turbo prune..." && \
    turbo prune @fern-docs/bundle --docker 2>&1 | add-timestamps

ARG CACHEBUST=1
COPY servers/self-hosted/scripts /scripts

# -----------  Start Postgres setup  -----------

# Create postgres user first
RUN log "Creating postgres user..." && \
    addgroup -g 70 -S postgres && \
    adduser -u 70 -S -D -G postgres -H -h /var/lib/postgresql -s /bin/sh postgres

# Install PostgreSQL packages
RUN log "Installing PostgreSQL..." && \
    apk add --no-cache postgresql postgresql-contrib postgresql-dev 2>&1 | add-timestamps && \
    mkdir -p /run/postgresql /var/lib/postgresql/data && \
    chown -R postgres:postgres /run/postgresql /var/lib/postgresql

# Set default Postgres user and password
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres
ENV DATABASE_NAME=fdr

# Note: PostgreSQL will be initialized at runtime in /tmp to avoid permission conflicts
# This allows the container to work with any UID (root or arbitrary non-root UIDs)

ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fdr

RUN log "Installing Prisma..." && \
    npm install -g prisma@5.13.0 2>&1 | add-timestamps

COPY servers/fdr/prisma /prisma

# -----------  End Postgres setup  -----------

# ----------- Start MINIO setup  -----------
RUN log "Installing MinIO..." && \
    apk add --no-cache wget 2>&1 | add-timestamps && \
    wget https://dl.min.io/server/minio/release/linux-amd64/minio 2>&1 | add-timestamps && \
    chmod +x minio && \
    mv minio /usr/local/bin/ && \
    adduser -D -s /bin/sh minio-user || true && \
    mkdir -p /data && \
    # Make data directory accessible to all users
    chmod 777 /data && \
    log "Installing MinIO client..." && \
    wget https://dl.min.io/client/mc/release/linux-amd64/mc 2>&1 | add-timestamps && \
    chmod +x mc && \
    mv mc /usr/local/bin/

ENV MINIO_VOLUMES="/data" \
    MINIO_URL="http://localhost:9000" \
    MINIO_ROOT_USER="minioadmin" \
    MINIO_ROOT_PASSWORD="minioadmin" \
    MINIO_USERNAME="minioadmin" \
    MINIO_PASSWORD="minioadmin"

# ----------- End MINIO setup  -----------

# ----------- Start MeiliSearch setup -----------
RUN log "Installing MeiliSearch..." && \
    apk add --no-cache curl bash strace 2>&1 | add-timestamps && \
    bash -c 'for i in {1..5}; do curl -L https://install.meilisearch.com 2>&1 | sh | add-timestamps && break || { log "MeiliSearch install failed, retrying ($i/5)..."; sleep 5; }; done' && \
    chmod 755 /meilisearch

# ----------- End MeiliSearch setup -----------

# ----------- Start FDR setup -----------
ENV LOCAL_MODE_OVERRIDE=true
ENV S3_FORCE_PATH_STYLE=true
COPY servers/fdr/cjs /fdr
COPY servers/fdr/prisma /fdr/prisma

WORKDIR /fdr
RUN log "Setting up FDR..." && \
    echo '{"name":"temp","version":"1.0.0","dependencies":{"@prisma/client":"5.13.0"},"devDependencies":{"prisma":"5.13.0"}}' > package.json
RUN log "Installing FDR dependencies..." && \
    npm install 2>&1 | add-timestamps
RUN log "Generating Prisma client..." && \
    npx prisma generate 2>&1 | add-timestamps

# Pre-generate Prisma engines and make them accessible
RUN log "Pre-generating Prisma engines..." && \
    mkdir -p /opt/prisma-engines && \
    find /fdr/node_modules/.prisma/client -type f -name "*engine*" -exec cp {} /opt/prisma-engines/ \; 2>/dev/null || true && \
    find /usr/local/lib/node_modules/prisma -type f -name "*engine*" -exec cp {} /opt/prisma-engines/ \; 2>/dev/null || true && \
    chmod -R 755 /opt/prisma-engines

# ----------- End FDR setup -----------
WORKDIR /

# ----------- Start fern cli installation -----------
# Configure npm to use writable directories for non-root users
ENV NPM_CONFIG_PREFIX=/tmp/npm-global
ENV NPM_CONFIG_CACHE=/tmp/npm-cache
ENV PATH=$PATH:/tmp/npm-global/bin
RUN log "Installing Fern CLI..." && \
    mkdir -p /tmp/npm-global /tmp/npm-cache && \
    npm install -g fern-api 2>&1 | add-timestamps && \
    chmod -R 777 /tmp/npm-global /tmp/npm-cache
# ----------- End fern cli installation -----------

# ----------- Start nextapp setup -----------
COPY docs_bundle.tar.gz .

RUN log "Setting up Next.js app..." && \
    mkdir -p /nextapp && \
    tar -xzf docs_bundle.tar.gz -C /nextapp && \
    cd /nextapp && \
    node -e "const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('package.json')); delete pkg.devDependencies['typescript-plugin-css-modules']; fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2));" && \
    # Install esbuild globally to ensure it's available everywhere
    npm i -g esbuild@0.25.9 2>&1 | add-timestamps && \
    # Ensure Next.js cache directory exists and is writable for restricted mode
    mkdir -p /nextapp/packages/fern-docs/bundle/.next/cache && \
    chmod -R 777 /nextapp/packages/fern-docs/bundle/.next && \
    mv /tmp/npm-global/lib/node_modules/esbuild /nextapp/node_modules/

# ----------- End nextapp setup -------------

RUN log "Installing jq and yq..." && \
    apk add --no-cache jq yq 2>&1 | add-timestamps

# ----------- Start Buf CLI setup -----------
RUN log "Installing Buf CLI..." && \
    wget https://github.com/bufbuild/buf/releases/latest/download/buf-Linux-x86_64 -O /usr/local/bin/buf 2>&1 | add-timestamps && \
    chmod +x /usr/local/bin/buf

# Pre-install buf's npm dependencies into a reusable location
RUN log "Pre-installing Buf npm dependencies..." && \
    mkdir -p /opt/buf-modules && \
    cd /opt/buf-modules && \
    echo '{"dependencies":{"@bufbuild/protobuf":"^2.2.5","@bufbuild/protoplugin":"2.2.5"}}' > package.json && \
    NPM_CONFIG_USERCONFIG=/dev/null npm install --no-audit --no-fund 2>&1 | add-timestamps && \
    chmod -R 777 /opt/buf-modules

# Replace npm with a wrapper that provides pre-installed modules for buf
RUN log "Creating npm wrapper for Buf..." && \
    mv /usr/bin/npm /usr/bin/npm-real && \
    printf '#!/bin/sh\n' > /usr/bin/npm && \
    printf 'if [ "$1" = "install" ] && [ -f "package.json" ] && grep -q "@bufbuild/protobuf" package.json 2>/dev/null; then\n' >> /usr/bin/npm && \
    printf '  if [ -d "/opt/buf-modules/node_modules" ]; then\n' >> /usr/bin/npm && \
    printf '    cp -r /opt/buf-modules/node_modules . 2>/dev/null && exit 0\n' >> /usr/bin/npm && \
    printf '  fi\n' >> /usr/bin/npm && \
    printf 'fi\n' >> /usr/bin/npm && \
    printf 'exec /usr/bin/npm-real "$@"\n' >> /usr/bin/npm && \
    chmod +x /usr/bin/npm

# Verify buf can export with the wrapper
RUN log "Verifying Buf CLI installation..." && \
    mkdir -p /tmp/buf-test && \
    cd /tmp/buf-test && \
    echo 'syntax = "proto3"; package test; message TestMessage { string field = 1; }' > test.proto && \
    echo 'version: v2' > buf.yaml && \
    buf export . --output /tmp/buf-output 2>&1 | add-timestamps && \
    cd / && rm -rf /tmp/buf-test /tmp/buf-output
# ----------- End Buf CLI setup -----------

# ----------- Setup for non-root execution -----------
# Ensure /tmp directory has proper permissions (sticky bit + world writable)
RUN log "Configuring permissions for non-root execution..." && \
    chmod 1777 /tmp && \
    # Create directories that may need write access at runtime
    mkdir -p /tmp/postgresql /tmp/minio-data /tmp/prisma && \
    chmod 777 /tmp/postgresql /tmp/minio-data /tmp/prisma && \
    # Make log directory writable
    mkdir -p /var/log && chmod 777 /var/log && \
    # Note: /tmp/meilisearch is NOT created at build time - it will be created by MeiliSearch at runtime
    # to ensure proper ownership for the user running the container
    # Create additional temp directories for services
    mkdir -p /tmp/fdr /tmp/nextapp /tmp/postgresql /tmp/minio-data /tmp/.next && chmod -R 777 /tmp/fdr /tmp/nextapp /tmp/postgresql /tmp/minio-data /tmp/.next && \
    # Make scripts executable by all
    chmod +x /scripts/*.sh /scripts/*.js && \
    # Ensure /etc/hosts can be modified (for local domain mapping)
    # Note: This won't work with readOnlyRootFilesystem, but won't break the container
    chmod 666 /etc/hosts 2>/dev/null || true

# Note: We do NOT use USER directive here to maintain flexibility
# The container can run as root (traditional) or any UID (restricted environments)

ENTRYPOINT ["/bin/bash", "/scripts/run.sh"]

