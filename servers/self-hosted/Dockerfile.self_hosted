# Self-hosted Fern docs container
# This Dockerfile uses a pre-built base image that contains heavy dependencies
# (Go binaries, PostgreSQL, MeiliSearch, Node.js, etc.) to speed up builds.
#
# The base image is built from Dockerfile.base and pushed to DockerHub.
# When base dependencies change, rebuild and push the base image first.

# Use the pre-built base image with all heavy dependencies
# ARG allows overriding the base image tag at build time
ARG BASE_IMAGE=fernapi/fern-self-hosted-base:latest
FROM ${BASE_IMAGE}

# Copy source code and run turbo prune
# Note: .git, .github/, and test files are excluded via .dockerignore
COPY . .
RUN log "Cleaning up fern directory..." && \
    rm -rf fern/

RUN log "Running turbo prune..." && \
    turbo prune @fern-docs/bundle --docker 2>&1 | add-timestamps

ARG CACHEBUST=1
COPY servers/self-hosted/scripts /scripts

# -----------  Start Postgres schema setup  -----------
COPY servers/fdr/prisma /prisma

# Run Prisma migrations at build time and save schema dump
# This allows customer builds and runtime to restore from dump instead of running migrations
RUN log "Running base image database seeding..." && \
    chmod +x /scripts/base-seed-db.sh && \
    /scripts/base-seed-db.sh 2>&1 | add-timestamps

# -----------  End Postgres schema setup  -----------

# ----------- Start FDR setup -----------
COPY servers/fdr/cjs /fdr
COPY servers/fdr/prisma /fdr/prisma

WORKDIR /fdr
RUN log "Setting up FDR..." && \
    echo '{"name":"temp","version":"1.0.0","dependencies":{"@prisma/client":"5.13.0"},"devDependencies":{"prisma":"5.13.0"}}' > package.json
RUN log "Installing FDR dependencies..." && \
    npm install 2>&1 | add-timestamps
RUN log "Generating Prisma client..." && \
    npx prisma generate 2>&1 | add-timestamps

# Pre-generate Prisma engines and make them accessible
RUN log "Pre-generating Prisma engines..." && \
    mkdir -p /opt/prisma-engines && \
    find /fdr/node_modules/.prisma/client -type f -name "*engine*" -exec cp {} /opt/prisma-engines/ \; 2>/dev/null || true && \
    find /usr/local/lib/node_modules/prisma -type f -name "*engine*" -exec cp {} /opt/prisma-engines/ \; 2>/dev/null || true && \
    chmod -R 755 /opt/prisma-engines

# ----------- End FDR setup -----------
WORKDIR /

# ----------- Start fern cli installation -----------
# NPM_CONFIG_PREFIX and NPM_CONFIG_CACHE are already set in base image
RUN log "Installing Fern CLI..." && \
    npm install -g fern-api 2>&1 | add-timestamps && \
    chmod -R 777 /tmp/npm-global /tmp/npm-cache
# ----------- End fern cli installation -----------

# ----------- Start nextapp setup -----------
COPY docs_bundle.tar.gz .

RUN log "Setting up Next.js app..." && \
    mkdir -p /nextapp && \
    tar -xzf docs_bundle.tar.gz -C /nextapp && \
    cd /nextapp && \
    node -e "const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('package.json')); delete pkg.devDependencies['typescript-plugin-css-modules']; fs.writeFileSync('package.json', JSON.stringify(pkg, null, 2));" && \
    mkdir -p /nextapp/packages/fern-docs/bundle/.next/cache && \
    chmod -R 777 /nextapp/packages/fern-docs/bundle && \
    mv /usr/local/lib/node_modules/esbuild /nextapp/node_modules/

# ----------- End nextapp setup -------------

# ----------- Start Jaeger setup (optional, for debugging) -----------
# Set ENABLE_JAEGER=true during docker build to include Jaeger tracing
ARG ENABLE_JAEGER=false
ENV ENABLE_JAEGER=${ENABLE_JAEGER}

# TARGETARCH is automatically set by Docker buildx (amd64, arm64, etc.)
ARG TARGETARCH

RUN if [ "$ENABLE_JAEGER" = "true" ]; then \
        log "Installing Jaeger for architecture: ${TARGETARCH:-amd64}..." && \
        JAEGER_ARCH="${TARGETARCH:-amd64}" && \
        curl -L "https://download.jaegertracing.io/v1.75.0/jaeger-2.12.0-linux-${JAEGER_ARCH}.tar.gz" -o /tmp/jaeger.tar.gz 2>&1 | add-timestamps && \
        tar -xzf /tmp/jaeger.tar.gz -C /tmp && \
        mv "/tmp/jaeger-2.12.0-linux-${JAEGER_ARCH}/jaeger" /usr/local/bin/jaeger && \
        chmod +x /usr/local/bin/jaeger && \
        rm -rf /tmp/jaeger.tar.gz "/tmp/jaeger-2.12.0-linux-${JAEGER_ARCH}"; \
    else \
        log "Skipping Jaeger installation (ENABLE_JAEGER not set to true)"; \
    fi

# Expose Jaeger UI port for viewing traces (only used when ENABLE_JAEGER=true)
EXPOSE 16686

# ----------- End Jaeger setup -----------

# -----------  Start npm vulnerability patches -----------
# Apply patches to ALL node_modules directories (system and app-specific)
# The base image has patches prepared in /tmp/patches/
# Patches: glob 10.x -> 10.5.0, glob 11.x -> 11.1.0, brace-expansion 2.0.x -> 2.0.2,
#          tar 7.x (<7.5.8) -> 7.5.8, ajv 8.x (<8.18.0) -> 8.18.0,
#          minimatch <10.2.1 -> 10.2.1
RUN log "Applying npm vulnerability patches to all node_modules..." && \
    for root in /usr/local/lib/node_modules /usr/lib/node_modules /opt/buf-modules /tmp/npm-global/lib/node_modules /fdr /nextapp; do \
        if [ -d "$root" ]; then \
            find "$root" -path "*/node_modules/glob/package.json" -o -path "*/dist/node_modules/glob/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -q "^10\."; then \
                    rm -rf "$dir" && cp -r /tmp/patches/glob-10/package "$dir" && log "Patched glob $version -> 10.5.0 at $dir"; \
                elif echo "$version" | grep -q "^11\."; then \
                    rm -rf "$dir" && cp -r /tmp/patches/glob-11/package "$dir" && log "Patched glob $version -> 11.1.0 at $dir"; \
                fi; \
            done; \
            find "$root" -path "*/node_modules/brace-expansion/package.json" -o -path "*/dist/node_modules/brace-expansion/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -q "^2\.0\.[01]$"; then \
                    rm -rf "$dir" && cp -r /tmp/patches/brace-expansion/package "$dir" && log "Patched brace-expansion $version -> 2.0.2 at $dir"; \
                fi; \
            done; \
            find "$root" -path "*/node_modules/tar/package.json" -o -path "*/dist/node_modules/tar/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -qE "^7\.[0-4]\." || echo "$version" | grep -qE "^7\.5\.[0-7]$"; then \
                    rm -rf "$dir" && cp -r /tmp/patches/tar/package "$dir" && log "Patched tar $version -> 7.5.8 at $dir"; \
                fi; \
            done; \
            find "$root" -path "*/node_modules/ajv/package.json" -o -path "*/dist/node_modules/ajv/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -qE "^8\.(1[0-7])\." || echo "$version" | grep -qE "^8\.[0-9]\." ; then \
                    rm -rf "$dir" && cp -r /tmp/patches/ajv/package "$dir" && log "Patched ajv $version -> 8.18.0 at $dir"; \
                fi; \
            done; \
            find "$root" -path "*/node_modules/minimatch/package.json" -o -path "*/dist/node_modules/minimatch/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -qE "^[0-9]\." || echo "$version" | grep -qE "^10\.[0-1]\." || echo "$version" | grep -qE "^10\.2\.0$"; then \
                    rm -rf "$dir" && cp -r /tmp/patches/minimatch/package "$dir" && log "Patched minimatch $version -> 10.2.1 at $dir"; \
                fi; \
            done; \
        fi; \
    done && \
    rm -rf /tmp/patches

# -----------  End npm vulnerability patches -----------

# ----------- Setup for non-root execution -----------
# Add standard nonroot user (UID 65532) used by Kubernetes security contexts.
# This must exist at build time for readOnlyRootFilesystem deployments where
# /etc/passwd cannot be modified at runtime.
#
# For other arbitrary UIDs with readOnlyRootFilesystem, set FERN_RUN_AS_UID
# in your downstream Dockerfile before running generate.sh:
#   FROM fernapi/fern-self-hosted:latest
#   ENV FERN_RUN_AS_UID=1000
#
# For writable filesystems, run.sh will add entries to /etc/passwd at runtime.
RUN log "Adding nonroot user for Kubernetes deployments..." && \
    if ! grep -q '^[^:]*:[^:]*:65532:' /etc/passwd 2>/dev/null; then \
        echo "nonroot:x:65532:65532:Nonroot User:/tmp:/bin/bash" >> /etc/passwd && \
        echo "nonroot:x:65532:" >> /etc/group && \
        log "Added nonroot user (UID 65532) to /etc/passwd"; \
    else \
        log "UID 65532 already exists in /etc/passwd"; \
    fi

# Ensure /tmp directory has proper permissions (sticky bit + world writable)
# Note: Service-specific directories (postgresql, seaweedfs-data, meilisearch, mc-config, prisma)
# are created at RUNTIME with UID-scoped paths (e.g., /tmp/postgresql-${UID})
# to avoid permission conflicts when running as arbitrary non-root UIDs
RUN log "Configuring permissions for non-root execution..." && \
    chmod 1777 /tmp && \
    # Make log directory writable
    mkdir -p /var/log && chmod 777 /var/log && \
    # Create temp directories for Next.js and FDR
    mkdir -p /tmp/fdr /tmp/nextapp /tmp/.next && chmod -R 777 /tmp/fdr /tmp/nextapp /tmp/.next && \
    # Make scripts executable by all
    chmod +x /scripts/*.sh /scripts/*.js && \
    # Create fern-generate alias for cleaner customer Dockerfiles
    ln -sf /scripts/generate.sh /usr/local/bin/fern-generate && \
    # Ensure /etc/hosts can be modified (for local domain mapping)
    # Note: This won't work with readOnlyRootFilesystem, but won't break the container
    chmod 666 /etc/hosts 2>/dev/null || true && \
    # Ensure /etc/passwd is writable so arbitrary UIDs (e.g., Kubernetes runAsUser)
    # can add themselves at runtime - required by PostgreSQL initdb
    chmod 666 /etc/passwd 2>/dev/null || true

# Set NODE_OPTIONS to increase memory limit for fern generate and other node commands
ENV NODE_OPTIONS="--max-old-space-size=4096"

ENTRYPOINT ["/bin/bash", "/scripts/run.sh"]

