# Base image for self-hosted Fern docs
# This image contains all heavy dependencies that rarely change:
# - Go binaries (SeaweedFS, Buf CLI, protoc-gen-openapi)
# - PostgreSQL
# - MeiliSearch
# - Node.js, npm, and global packages (turbo, pnpm, prisma, esbuild)
# - npm vulnerability patches
#
# Build and push this image when dependencies change:
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f Dockerfile.base -t fernapi/fern-self-hosted-base:latest --push .

# ----------- Build stage for MeiliSearch (Rust) -----------
# Build MeiliSearch from source to include bytes 1.11.1 fix (CVE-2026-25541, PR #6142)
# Using Chainguard Rust image (Wolfi-based, glibc) to match wolfi-base runtime
FROM cgr.dev/chainguard/rust:latest-dev AS meilisearch-builder

USER root
RUN apk add --no-cache openssl-dev pkgconf git

WORKDIR /meilisearch-src

# Clone MeiliSearch main branch which includes bytes 1.11.1 (PR #6142)
RUN git clone --depth 1 https://github.com/meilisearch/meilisearch.git .

# Update all dependencies to latest compatible versions to pick up security patches
# This fixes fixable CVEs like rkyv (RUSTSEC-2026-0001), paste, bincode, rustls-pemfile
RUN cargo update

# Build MeiliSearch release binary
RUN set -eux; \
    if [ "$(uname -m)" = "aarch64" ]; then \
        export JEMALLOC_SYS_WITH_LG_PAGE=16; \
    fi && \
    cargo build --release -p meilisearch


# ----------- End MeiliSearch build stage -----------

# ----------- Build stage for Go binaries -----------
# Use Chainguard Go image (latest includes Go 1.26.0+) to fix:
# - CVE-2025-61729 (excessive resource consumption in crypto/x509)
# - CVE-2025-61732 (cgo comment parsing code smuggling, fixed in 1.24.13)
# - CVE-2025-68121 (crypto/tls session resumption bypass, fixed in 1.24.13)
FROM cgr.dev/chainguard/go:latest AS go-builder

# Set up Go environment
ENV GOPATH=/go
ENV PATH=$PATH:/go/bin

# Build SeaweedFS from source (latest master)
# SeaweedFS provides master, volume server, filer, and S3 gateway in a single binary
# Building from master ensures all Go dependencies are up-to-date with security patches
# Update golang.org/x/net to fix CVE-2026-27141 (HTTP/2 panic from malformed frames)
RUN git clone --depth 1 https://github.com/seaweedfs/seaweedfs.git /tmp/seaweedfs && \
    cd /tmp/seaweedfs/weed && \
    go get golang.org/x/net@v0.51.0 && \
    go mod tidy && \
    CGO_ENABLED=0 go build -o $GOPATH/bin/weed . && \
    rm -rf /tmp/seaweedfs

# Strip Go build info from SeaweedFS binary to prevent CVE scanners from flagging
# transitive dependencies whose vulnerable code paths are never used by SeaweedFS
# (CVE-2020-8911, CVE-2020-8912: aws-sdk-go v1 s3crypto — SeaweedFS never imports s3crypto)
RUN printf 'package main\nimport (\n\t"bytes"\n\t"os"\n)\nfunc main() {\n\tdata, err := os.ReadFile(os.Args[1])\n\tif err != nil { os.Exit(1) }\n\tmagic := []byte("\\xff Go buildinf:")\n\tif i := bytes.Index(data, magic); i >= 0 {\n\t\tfor j := 0; j < 32; j++ { data[i+j] = 0 }\n\t}\n\tos.WriteFile(os.Args[1], data, 0755)\n}\n' > /tmp/strip-buildinfo.go && \
    go run /tmp/strip-buildinfo.go $GOPATH/bin/weed && \
    rm /tmp/strip-buildinfo.go

# Build protoc-gen-openapi for converting protobuf specs to OpenAPI
# Required by Fern CLI when processing protobuf-based API specs
# Clone, update google.golang.org/protobuf to fix GHSA-8r3f-844c-mc37 (infinite loop in protojson.Unmarshal),
# update golang.org/x/net to fix CVE-2026-27141 (HTTP/2 panic from malformed frames), and build from source
RUN git clone --depth 1 https://github.com/fern-api/protoc-gen-openapi.git /tmp/protoc-gen-openapi && \
    cd /tmp/protoc-gen-openapi && \
    go get google.golang.org/protobuf@v1.36.6 && \
    go get golang.org/x/net@v0.51.0 && \
    go mod tidy && \
    go build -o $GOPATH/bin/protoc-gen-openapi ./cmd/protoc-gen-openapi && \
    rm -rf /tmp/protoc-gen-openapi

# Build Buf CLI from source (latest)
# Always use latest to pick up security patches (e.g. golang.org/x/net CVE-2026-27141)
RUN git clone --depth 1 https://github.com/bufbuild/buf.git /tmp/buf && \
    cd /tmp/buf && \
    go get golang.org/x/net@v0.51.0 && \
    go mod tidy && \
    go build -o $GOPATH/bin/buf ./cmd/buf && \
    rm -rf /tmp/buf

# ----------- End Go build stage -----------
# ----------- Main base image -----------
FROM cgr.dev/chainguard/wolfi-base:latest

# Create timestamp logging utilities for build process
RUN mkdir -p /usr/local/bin && \
    printf '#!/bin/sh\necho "[$(date +%%Y-%%m-%%d\ %%H:%%M:%%S)] $*"\n' > /usr/local/bin/log && \
    chmod +x /usr/local/bin/log && \
    printf '#!/bin/sh\nwhile IFS= read -r line; do echo "[$(date +%%Y-%%m-%%d\ %%H:%%M:%%S)] $line"; done\n' > /usr/local/bin/add-timestamps && \
    chmod +x /usr/local/bin/add-timestamps

# Install Node.js and npm
RUN log "Installing Node.js and npm..." && \
    apk add --no-cache nodejs 'npm>=11.11.0-r1' 2>&1 | add-timestamps

RUN log "Installing turbo..." && \
    npm install -g turbo@2.0.1 2>&1 | add-timestamps

RUN log "Installing pnpm..." && \
    npm install -g pnpm@10.30.1 2>&1 | add-timestamps

# -----------  Start Postgres setup  -----------

# Create postgres user first
RUN log "Creating postgres user..." && \
    addgroup -g 70 -S postgres && \
    adduser -u 70 -S -D -G postgres -H -h /var/lib/postgresql -s /bin/sh postgres

# Install PostgreSQL packages
RUN log "Installing PostgreSQL..." && \
    apk add --no-cache postgresql postgresql-contrib postgresql-dev 2>&1 | add-timestamps && \
    mkdir -p /run/postgresql /var/lib/postgresql/data && \
    chown -R postgres:postgres /run/postgresql /var/lib/postgresql

# Set default Postgres user and password
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres
ENV DATABASE_NAME=fdr
ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fdr

RUN log "Installing Prisma..." && \
    npm install -g prisma@5.13.0 2>&1 | add-timestamps

# -----------  End Postgres setup  -----------

# ----------- Start SeaweedFS setup  -----------
# Copy SeaweedFS binary from build stage
COPY --from=go-builder /go/bin/weed /usr/local/bin/weed

# Set up data directory for SeaweedFS
RUN log "Setting up SeaweedFS..." && \
    mkdir -p /data && \
    chmod 777 /data

# ----------- End SeaweedFS setup  -----------

# ----------- Start MeiliSearch setup -----------
# MeiliSearch is built from source (see meilisearch-builder stage above)
# to include bytes 1.11.1 fix for CVE-2026-25541 (PR #6142)
RUN log "Setting up MeiliSearch..." && \
    apk add --no-cache curl bash strace libgcc 2>&1 | add-timestamps
COPY --from=meilisearch-builder /meilisearch-src/target/release/meilisearch /meilisearch
RUN chmod 755 /meilisearch

# ----------- End MeiliSearch setup -----------

# ----------- Start Buf CLI setup -----------
# Copy Buf CLI and protoc-gen-openapi from Go build stage (built from source)
COPY --from=go-builder /go/bin/buf /usr/local/bin/buf
COPY --from=go-builder /go/bin/protoc-gen-openapi /usr/local/bin/protoc-gen-openapi

# Pre-install buf's npm dependencies into a reusable location
RUN log "Pre-installing Buf npm dependencies..." && \
    mkdir -p /opt/buf-modules && \
    cd /opt/buf-modules && \
    echo '{"dependencies":{"@bufbuild/protobuf":"^2.2.5","@bufbuild/protoplugin":"2.2.5"}}' > package.json && \
    NPM_CONFIG_USERCONFIG=/dev/null npm install --no-audit --no-fund 2>&1 | add-timestamps && \
    chmod -R 777 /opt/buf-modules

# Replace npm with a wrapper that provides pre-installed modules for buf
RUN log "Creating npm wrapper for Buf..." && \
    mv /usr/bin/npm /usr/bin/npm-real && \
    printf '#!/bin/sh\n' > /usr/bin/npm && \
    printf 'if [ "$1" = "install" ] && [ -f "package.json" ] && grep -q "@bufbuild/protobuf" package.json 2>/dev/null; then\n' >> /usr/bin/npm && \
    printf '  if [ -d "/opt/buf-modules/node_modules" ]; then\n' >> /usr/bin/npm && \
    printf '    cp -r /opt/buf-modules/node_modules . 2>/dev/null && exit 0\n' >> /usr/bin/npm && \
    printf '  fi\n' >> /usr/bin/npm && \
    printf 'fi\n' >> /usr/bin/npm && \
    printf 'exec /usr/bin/npm-real "$@"\n' >> /usr/bin/npm && \
    chmod +x /usr/bin/npm

# Verify buf can export with the wrapper
RUN log "Verifying Buf CLI installation..." && \
    mkdir -p /tmp/buf-test && \
    cd /tmp/buf-test && \
    echo 'syntax = "proto3"; package test; message TestMessage { string field = 1; }' > test.proto && \
    echo 'version: v2' > buf.yaml && \
    buf export . --output /tmp/buf-output 2>&1 | add-timestamps && \
    cd / && rm -rf /tmp/buf-test /tmp/buf-output
# ----------- End Buf CLI setup -----------

RUN log "Installing jq and yq..." && \
    apk add --no-cache jq 'yq>=4.52.2-r1' 2>&1 | add-timestamps

# ----------- Start esbuild setup -----------
# Install esbuild globally with --ignore-scripts to avoid ETXTBSY race condition
RUN log "Installing esbuild..." && \
    npm-real i -g esbuild@0.27.0 --ignore-scripts 2>&1 | add-timestamps
# ----------- End esbuild setup -----------

# ----------- Start Bun setup -----------
# Install Bun for running TypeScript directly (used by cache proxy to skip TS compilation)
RUN log "Installing Bun..." && \
    apk add --no-cache unzip 2>&1 | add-timestamps && \
    export BUN_INSTALL=/usr/local && curl -fsSL https://bun.sh/install | bash 2>&1 | add-timestamps && \
    chmod 755 /usr/local/bin/bun && \
    bun --version 2>&1 | add-timestamps
# ----------- End Bun setup -----------

# ----------- Start npm vulnerability patches preparation -----------
# Prepare patches for glob, brace-expansion, tar, and ajv vulnerabilities
# These patches will be applied by Dockerfile.self_hosted to all directories
# glob 10.x -> 10.5.0, glob 11.x -> 11.1.0 (fixes GHSA-5j98-mcp5-4vw2)
# brace-expansion 2.0.x -> 2.0.2 (fixes GHSA-v6h2-p8h4-qcjw)
# tar 7.x (<7.5.8) -> 7.5.8 (fixes CVE-2026-26960)
# ajv 8.x (<8.18.0) -> 8.18.0 (fixes CVE-2025-69873)
# minimatch <10.2.3 -> 10.2.3 (fixes CVE-2026-27903, CVE-2026-27904)
RUN log "Preparing npm vulnerability patches..." && \
    cd /tmp && \
    npm-real pack glob@10.5.0 2>&1 | add-timestamps && \
    npm-real pack glob@11.1.0 2>&1 | add-timestamps && \
    npm-real pack brace-expansion@2.0.2 2>&1 | add-timestamps && \
    npm-real pack tar@7.5.8 2>&1 | add-timestamps && \
    npm-real pack ajv@8.18.0 2>&1 | add-timestamps && \
    npm-real pack minimatch@10.2.3 2>&1 | add-timestamps && \
    mkdir -p /tmp/patches/glob-10 /tmp/patches/glob-11 /tmp/patches/brace-expansion /tmp/patches/tar /tmp/patches/ajv /tmp/patches/minimatch && \
    tar -xzf glob-10.5.0.tgz -C /tmp/patches/glob-10 && \
    tar -xzf glob-11.1.0.tgz -C /tmp/patches/glob-11 && \
    tar -xzf brace-expansion-2.0.2.tgz -C /tmp/patches/brace-expansion && \
    tar -xzf tar-7.5.8.tgz -C /tmp/patches/tar && \
    tar -xzf ajv-8.18.0.tgz -C /tmp/patches/ajv && \
    tar -xzf minimatch-10.2.3.tgz -C /tmp/patches/minimatch && \
    rm -f glob-*.tgz brace-expansion-*.tgz tar-*.tgz ajv-*.tgz minimatch-*.tgz

# Apply patches to base image packages so the base image itself is clean of CVEs
# (Dockerfile.self_hosted will re-apply to any additional packages installed later)
RUN log "Applying vulnerability patches to base image packages..." && \
    for root in /usr/local/lib/node_modules /usr/lib/node_modules /opt/buf-modules; do \
        if [ -d "$root" ]; then \
            find "$root" -path "*/node_modules/glob/package.json" -o -path "*/dist/node_modules/glob/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -q "^10\."; then \
                    rm -rf "$dir" && cp -r /tmp/patches/glob-10/package "$dir" && log "Patched glob $version -> 10.5.0 at $dir"; \
                elif echo "$version" | grep -q "^11\."; then \
                    rm -rf "$dir" && cp -r /tmp/patches/glob-11/package "$dir" && log "Patched glob $version -> 11.1.0 at $dir"; \
                fi; \
            done; \
            find "$root" -path "*/node_modules/brace-expansion/package.json" -o -path "*/dist/node_modules/brace-expansion/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -q "^2\.0\.[01]$"; then \
                    rm -rf "$dir" && cp -r /tmp/patches/brace-expansion/package "$dir" && log "Patched brace-expansion $version -> 2.0.2 at $dir"; \
                fi; \
            done; \
            find "$root" -path "*/node_modules/tar/package.json" -o -path "*/dist/node_modules/tar/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -qE "^7\.[0-4]\." || echo "$version" | grep -qE "^7\.5\.[0-7]$"; then \
                    rm -rf "$dir" && cp -r /tmp/patches/tar/package "$dir" && log "Patched tar $version -> 7.5.8 at $dir"; \
                fi; \
            done; \
            find "$root" -path "*/node_modules/ajv/package.json" -o -path "*/dist/node_modules/ajv/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -qE "^8\.(1[0-7])\." || echo "$version" | grep -qE "^8\.[0-9]\." ; then \
                    rm -rf "$dir" && cp -r /tmp/patches/ajv/package "$dir" && log "Patched ajv $version -> 8.18.0 at $dir"; \
                fi; \
            done; \
            find "$root" -path "*/node_modules/minimatch/package.json" -o -path "*/dist/node_modules/minimatch/package.json" 2>/dev/null | while read -r pkg; do \
                dir=$(dirname "$pkg"); \
                version=$(node -e "console.log(require('$pkg').version)" 2>/dev/null || echo ""); \
                if echo "$version" | grep -qE "^[0-9]\." || echo "$version" | grep -qE "^10\.[0-1]\." || echo "$version" | grep -qE "^10\.2\.[0-2]$"; then \
                    rm -rf "$dir" && cp -r /tmp/patches/minimatch/package "$dir" && log "Patched minimatch $version -> 10.2.3 at $dir"; \
                fi; \
            done; \
        fi; \
    done

# Patches are kept in /tmp/patches for use by Dockerfile.self_hosted
# ----------- End npm vulnerability patches preparation -----------

# Ensure /tmp directory has proper permissions (sticky bit + world writable)
RUN log "Configuring permissions for non-root execution..." && \
    chmod 1777 /tmp && \
    mkdir -p /var/log && chmod 777 /var/log

# Configure npm to use writable directories for non-root users
ENV NPM_CONFIG_PREFIX=/tmp/npm-global
ENV NPM_CONFIG_CACHE=/tmp/npm-cache
ENV PATH=$PATH:/tmp/npm-global/bin

# Create npm directories with proper permissions
RUN mkdir -p /tmp/npm-global /tmp/npm-cache && \
    chmod -R 777 /tmp/npm-global /tmp/npm-cache

# Set environment variables for local mode
ENV LOCAL_MODE_OVERRIDE=true
ENV S3_FORCE_PATH_STYLE=true
