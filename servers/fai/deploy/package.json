{
  "name": "@fern-platform/fai-deploy",
  "version": "0.1.0",
  "bin": "bin/fai-deploy.js",
  "scripts": {
    "cdk": "cdk",
    "deploy:dev": "cdk deploy fai-dev2 --require-approval never --progress events",
    "deploy:prod": "cdk deploy fai-prod --require-approval never --progress events",
    "deploy:discord-dev": "cdk --app 'npx ts-node bin/deploy-discord.ts' deploy fai-discord-dev2 --require-approval never --progress events",
    "deploy:discord-prod": "cdk --app 'npx ts-node bin/deploy-discord.ts' deploy fai-discord-prod --require-approval never --progress events"
  },
  "dependencies": {
    "@fern-fern/fern-cloud-sdk": "^0.0.305",
    "aws-cdk-lib": "^2.215.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/prettier": "2.6.0",
    "aws-cdk": "^2.1029.1",
    "ts-node": "^10.9.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
