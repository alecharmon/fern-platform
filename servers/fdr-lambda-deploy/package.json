{
  "name": "@fern-platform/fdr-lambda-deploy",
  "version": "0.1.0",
  "bin": "bin/fdr-lambda-deploy.js",
  "scripts": {
    "cdk": "cdk",
    "deploy:dev": "cdk deploy fdr-lambda-dev2 --require-approval never --progress events",
    "deploy:preview": "cdk deploy fdr-lambda-preview-$PR_NUMBER --require-approval never --progress events --outputs-file preview-output.json",
    "deploy:prod": "cdk deploy fdr-lambda-prod --require-approval never --progress events",
    "destroy:preview": "cdk destroy fdr-lambda-preview-$PR_NUMBER --force",
    "watch": "tsc -w"
  },
  "dependencies": {
    "@fern-fern/fern-cloud-sdk": "^0.0.305",
    "aws-cdk-lib": "^2.215.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1029.1",
    "ts-node": "^10.9.1",
    "typescript": "catalog:"
  }
}
