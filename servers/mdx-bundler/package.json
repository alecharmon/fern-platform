{
  "name": "@fern-platform/mdx-bundler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "build:tsup:cjs": "tsup src/server.ts --config tsup.config.ts --format cjs --out-dir cjs",
    "build:tsup:esm": "tsup src/server.ts --format esm --out-dir dist/esm",
    "bundler:build": "tsc --build",
    "bundler:start": "tsx src/server.ts",
    "clean": "rm -rf ./dist && tsc --build --clean",
    "compile": "tsc --build",
    "docker": "./create_docker.sh",
    "run:tsup:cjs": "node cjs/server.cjs"
  },
