# ECS Fargate optimized Dockerfile for fai-chat
# Unlike the Lambda version, this doesn't use Lambda Web Adapter
FROM public.ecr.aws/docker/library/python:3.13-slim

# Install system dependencies (git for poetry, curl for health checks)
# Update GnuTLS to fix CVE-2025-14831 (Medium) - pinned from sid until trixie backport lands
RUN echo 'deb http://deb.debian.org/debian sid main' > /etc/apt/sources.list.d/sid.list && \
    printf 'Package: *\nPin: release a=unstable\nPin-Priority: 100\n' > /etc/apt/preferences.d/sid && \
    apt-get update && \
    apt-get install -y -t sid libgnutls30t64 && \
    apt-get install -y git curl && \
    rm -f /etc/apt/sources.list.d/sid.list /etc/apt/preferences.d/sid && \
    rm -rf /var/lib/apt/lists/*

RUN pip3 install poetry

WORKDIR /app/servers/fai-chat

COPY servers/fai-chat/pyproject.toml servers/fai-chat/poetry.lock* ./
COPY servers/python-libs/fai_ai_core /app/servers/python-libs/fai_ai_core

RUN poetry config virtualenvs.create false && \
    poetry install --only main --no-root

COPY servers/fai-chat/src/ ./src/

ENV PYTHONPATH="/app/servers/fai-chat:${PYTHONPATH:-}"
ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080

# Uvicorn with ECS-optimized settings:
# --timeout-keep-alive=900: Match ALB idle timeout for long SSE streams
# --limit-concurrency=300: High limit for I/O-bound async workload (LLM streaming)
CMD ["python", "-m", "uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8080", "--timeout-keep-alive", "900", "--limit-concurrency", "300"]
