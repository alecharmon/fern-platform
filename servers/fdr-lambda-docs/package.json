{
  "name": "@fern-platform/fdr-lambda-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist lambda.zip",
    "deploy:lambda": "pnpm package && aws lambda update-function-code --function-name fdr-lambda-docs --zip-file fileb://lambda.zip",
    "dev": "tsup --watch",
    "dev:server": "tsx src/dev-server.ts --watch",
    "package": "pnpm build && cd dist && zip -r ../lambda.zip . && cd ..",
    "test": "vitest --run --globals",
    "test:watch": "vitest --globals"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.936.0",
    "@types/aws-lambda": "^8.10.143",
    "openai": "6.8.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@fern-platform/configs": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "express": "^5.0.0",
    "tsup": "catalog:",
    "tsx": "^4.7.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@9.0.0"
}
